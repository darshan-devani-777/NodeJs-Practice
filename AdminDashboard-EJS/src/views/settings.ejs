<%- include('layouts/header', { user: user, showSidebar: showSidebar }) %>

<div class="min-h-screen bg-gray-100 flex items-center justify-center bg-gradient-to-br from-blue-50 via-white to-slate-100 py-12 px-3">
  <div class="w-full max-w-3xl bg-white rounded-3xl shadow-xl flex flex-col md:flex-row overflow-hidden border border-gray-200">
    <!-- LEFT: Profile Details -->
    <div class="md:w-1/2 bg-gradient-to-b from-blue-50 to-blue-100 flex flex-col items-center justify-center px-6 py-10">
      <div class="flex flex-col items-center mb-8">
        <div class="relative group">
          <img id="profileAvatar" src="" alt="Profile Avatar"
            class="w-32 h-32 rounded-full border-4 border-blue-200 shadow-md object-cover transition hover:scale-105 duration-200" />
          <button type="button" id="newAvatarBtn"
            class="absolute bottom-2 right-2 bg-white shadow px-3 py-1 rounded-full text-xs text-blue-600 border border-blue-400 font-semibold hover:bg-blue-50 transition-opacity opacity-0 group-hover:opacity-100">
              Change
          </button>
        </div>
        <h3 class="mt-5 text-lg font-bold text-blue-700"><%= user.name %></h3>
        <div class="text-gray-600 text-xs mt-2 flex flex-col items-center">
          <span><i class="fas fa-envelope mr-1"></i> <%= user.email %></span>
          <span><i class="fas fa-user-tag mr-1"></i> <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></span>
        </div>
      </div>
      <div class="w-full">
        <div class="text-center text-gray-400 text-xs">
          Last update:
          <span id="profileUpdated">
            <%
              const d = new Date();
              const day = d.getDate().toString().padStart(2, '0');
              const month = (d.getMonth() + 1).toString().padStart(2, '0');
              const year = d.getFullYear();
            %>
            <%= `${day}/${month}/${year}` %>
          </span>
        </div>
      </div>
    </div>
    <!-- RIGHT: Edit Form -->
    <div class="md:w-1/2 p-8 flex flex-col justify-center">
      <h2 class="text-xl font-bold mb-2 text-blue-800 underline text-center">Profile Settings</h2>
      <p class="mb-6 text-xs text-center text-gray-500">Edit your account information</p>
      <form id="profileForm" class="flex flex-col gap-5 w-full">
        <div>
          <label class="block mb-1 font-semibold text-gray-700">Name</label>
          <input type="text" name="name" value="<%= user.name %>"
            class="w-full border border-gray-300 px-4 py-2 rounded-xl text-sm focus:border-blue-500 focus:ring" required />
        </div>
        <div>
          <label class="block mb-1 font-semibold text-gray-700">Email</label>
          <input type="email" name="email" value="<%= user.email %>" class="w-full border border-gray-300 px-4 py-2 rounded-xl text-sm
                 <%= user.role === 'admin' ? 'bg-gray-100 cursor-not-allowed' : '' %>" <%=user.role==='admin'
            ? 'readonly' : 'required' %>
          />
        </div>
        <div>
          <label class="block mb-1 font-semibold text-gray-700">New Password</label>
          <div class="relative">
            <input type="password" name="password" id="password"
              class="w-full border border-gray-300 px-4 py-2 rounded-xl text-sm pr-10"
              placeholder="Leave blank if not changing" />
            <button type="button" id="togglePassword"
              class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-600 hover:text-gray-900">
              <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>
        <div class="flex justify-end">
          <button type="submit"
            class="px-5 py-2 bg-blue-600 text-white rounded-xl font-semibold text-sm shadow hover:bg-blue-700 transition">
            Update
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Toast Notification -->
<div id="toast"
  class="fixed top-6 right-2 md:right-6 px-4 py-2 rounded shadow hidden z-50 text-white text-sm"></div>

<script>
  function showToast(msg, type = "success") {
    const toast = document.getElementById("toast");
    toast.textContent = msg;
    toast.className = `fixed top-6 right-2 md:right-6 px-4 py-2 rounded shadow text-sm z-50 
      ${type === "success" ? "bg-green-600" : "bg-red-600"} text-white`;
    toast.classList.remove("hidden");
    setTimeout(() => {
      toast.classList.add("hidden");
    }, 3000);
  }

  // --- Eye Hide/Show for Password ---
  const passwordInput = document.getElementById('password');
  const togglePasswordBtn = document.getElementById('togglePassword');
  const eyeIcon = document.getElementById('eyeIcon');

  if (togglePasswordBtn && passwordInput) {
    togglePasswordBtn.addEventListener('click', function () {
      const type = passwordInput.getAttribute('type');
      if (type === 'password') {
        passwordInput.setAttribute('type', 'text');
        // Use crossed eye icon
        eyeIcon.innerHTML = `
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.956 9.956 0 012.293-3.95m2.211-2.148A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a9.97 9.97 0 01-4.032 5.021"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
        `;
      } else {
        passwordInput.setAttribute('type', 'password');
        // Use regular open eye icon
        eyeIcon.innerHTML = `
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        `;
      }
    });
  }

  // Profile Avatar
  const avatarImg = document.getElementById('profileAvatar');
  const newAvatarBtn = document.getElementById('newAvatarBtn');
  function setRandomAvatar() {
    const seed = Date.now() + Math.floor(Math.random() * 1000);
    avatarImg.src = `https://robohash.org/${seed}.png?size=150x150`;
  }
  setRandomAvatar();
  newAvatarBtn.addEventListener('click', setRandomAvatar);

  const form = document.getElementById('profileForm');
  const btn = form.querySelector('button[type="submit"]');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Updating...';

    const formData = new FormData(form);

    const body = Object.fromEntries(formData.entries());
    if ('<%= user.role %>' === 'admin') {
      delete body.email;
    }
    try {
      const res = await fetch('/api/auth/update-profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(body),
      });

      const data = await res.json();

      if (data.message) {
        showToast(data.message, data.success ? "success" : "error");
      }

      if (data.redirect) {
        setTimeout(() => {
          window.location.href = data.redirect;
        }, 3000);
      }

      if (data.success) {
        const updated = document.getElementById('profileUpdated');
        if (updated) updated.textContent = new Date().toLocaleDateString();
      }

      btn.disabled = false;
      btn.textContent = originalText;

    } catch (err) {
      console.error(err);
      showToast('Something went wrong!', 'error');
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>

<%- include('layouts/footer') %>