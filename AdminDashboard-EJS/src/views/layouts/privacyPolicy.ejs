<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-slate-100 p-6">
  <!-- HEADER -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-3">
    <div>
      <h1 class="text-4xl font-extrabold text-blue-900 tracking-tight flex items-center gap-4 drop-shadow-md">
        <i class="fas fa-file-contract text-blue-400 animate-pulse"></i>
        <span>Privacy Policy</span>
      </h1>
    </div>
    <% if (user.role==='admin' ) { %>
      <div id="policyActionBtnContainer">
        <button id="policyActionBtn" onclick="openEditModal()"
          class="px-4 py-2 text-xs rounded bg-yellow-500 text-white hover:bg-yellow-600 transition flex items-center gap-2">
          Loading...
        </button>
      </div>
      <% } %>
  </div>

  <!-- POLICY CONTENT -->
  <div id="policyContainer" class="space-y-3 [&>section]:space-y-2 [&>div]:space-y-1"></div>

  <!-- EDIT MODAL - CREATE/UPDATE  -->
  <% if (user.role==='admin' ) { %>
    <div id="editModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
      <div class="bg-white w-full max-w-4xl max-h-[90vh] rounded-xl shadow-2xl flex flex-col">
        <div class="flex justify-between items-center p-6 border-b border-gray-200 shrink-0">
          <h2 id="modalTitle" class="text-lg font-bold text-blue-800">Edit Privacy Policy</h2>
          <button onclick="closeEditModal()" class="text-gray-500 hover:text-red-500 p-2 hover:bg-gray-100 rounded">
            <i class="fas fa-times text-lg"></i>
          </button>
        </div>

        <!-- SCROLLABLE FORM -->
        <div class="flex-1 overflow-hidden flex flex-col max-h-[70vh]">
          <form id="editForm" onsubmit="savePolicy(event)" class="flex-1 flex flex-col overflow-hidden h-full">
            <!-- EDITOR CONTAINER  -->
            <div class="flex-1 overflow-y-auto p-6 border-b bg-gray-50/50 min-h-[400px]">
              <label class="block text-xs font-medium text-gray-700 mb-3 pb-1">Policy Content</label>

              <!-- NEW HELPER BUTTONS -->
              <div class="mb-4 flex flex-wrap gap-2">
                <button type="button" onclick="loadSampleData()"
                  class="px-4 py-2 text-xs bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-1 shadow-sm transition duration-300">
                  Load Sample
                </button>
                <button type="button" onclick="clearEditorData()"
                  class="px-4 py-2 text-xs bg-gray-600 text-white rounded-lg hover:bg-gray-700 flex items-center gap-1 shadow-sm transition duration-300">
                  Clear
                </button>
              </div>

              <div class="w-full h-[450px]">
                <textarea id="policyEditor" class="w-full h-full"></textarea>
              </div>
            </div>

            <!-- BUTTONS -->
            <div class="p-6 border-t bg-white flex justify-end gap-2 pt-4 shrink-0">
              <button type="submit"
                class="px-6 py-2 text-sm rounded bg-blue-600 text-white hover:bg-blue-700 transition flex items-center gap-2">
                <svg id="saveSpinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg"
                  fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                </svg>
                <span id="saveBtnText">Save</span>
              </button>
              <button type="button" onclick="closeEditModal()"
                class="px-6 py-2 text-sm rounded bg-gray-400 text-white hover:bg-gray-500">Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <% } %>

      <div id="toast" class="fixed top-6 right-6 px-4 py-2 rounded shadow hidden z-50 text-white text-sm"></div>
</div>

<style>
  #policyContainer * {
    line-height: 1.4 !important;
    margin-bottom: 0.125em !important;
  }

  #policyContainer br {
    display: none !important;
  }

  #policyContainer p:empty {
    display: none !important;
  }

  #editModal .ck-editor__editable_inline,
  #editModal .ck-content {
    line-height: 1.4 !important;
    padding: 12px 16px !important;
    margin: 0 !important;
    overflow-y: auto !important;
    scrollbar-width: thin;
    max-height: 390px !important;
    min-height: 350px !important;
  }

  #editModal .ck-content::-webkit-scrollbar {
    width: 6px;
  }

  #editModal .ck-content::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 3px;
  }

  #editModal .ck-content::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }

  #editModal .ck-content::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  #editModal .ck-content p {
    margin-bottom: 0.125em !important;
    margin-top: 0 !important;
  }

  #editModal .ck-content br {
    display: none !important;
  }

  #editModal .ck-content h3 {
    margin: 0.5em 0 0.25em 0 !important;
    font-size: 1.125rem !important;
    color: #1e40af !important;
  }

  #editModal #policyEditor {
    height: 100% !important;
    min-height: 350px !important;
  }
</style>

<script>
  let policyData = [];
  let policyEditorInstance;

  function initPolicyEditor() {
    if (policyEditorInstance) return;

    ClassicEditor
      .create(document.querySelector('#policyEditor'), {
        placeholder: 'Write your Privacy Policy here...',
        toolbar: [
          'undo', 'redo', '|', 'heading', '|',
          'bold', 'italic', 'link', 'bulletedList', 'numberedList', '|',
          'blockQuote', 'insertTable', 'mediaEmbed', '|',
          'alignment', 'removeFormat'
        ],
        heading: {
          options: [
            { model: 'paragraph', title: 'Paragraph', class: 'ck-heading_paragraph' },
            { model: 'heading3', view: 'h3', title: 'Heading 3', class: 'ck-heading_h3' }
          ]
        },
        contentStyle: `
        * { margin: 0 !important; padding: 0 !important; line-height: 1.4 !important; }
        h3 { font-weight: bold; color: #1e40af; margin: 0 0 0.25em 0 !important; }
        p { font-size: 0.875rem; color: #374151; margin: 0 0 0.125em 0 !important; }
        br { display: none !important; }
        strong { font-weight: bold; }
        a { color: #1d4ed8; text-decoration: underline; }
        ul, ol { padding-left: 1.5rem; margin: 0.25em 0 !important; }
        li { margin-bottom: 0.125em !important; }
      `
      })
      .then(editor => {
        policyEditorInstance = editor;
        const editable = editor.ui.view.editable.element;
        editable.style.maxHeight = '320px'; 
        editable.style.minHeight = '300px';  
        editable.style.overflowY = 'auto';
      })
      .catch(err => console.error("CKEditor init error:", err));
  }

  async function fetchPolicy() {
    try {
      const res = await fetch("/api/privacypolicy/view", { headers: { Accept: "application/json" } });
      const data = await res.json();

      if (!data.success) {
        const btn = document.getElementById("policyActionBtn");
        if (btn) {
          btn.innerHTML = `<i class="fas fa-plus text-[10px]"></i> Create Policy`;
          btn.onclick = openEditModal;
        }
        policyData = [];
        renderPolicy();
        return;
      }

      policyData = data.data.sections || [];
      renderPolicy();

      const btn = document.getElementById("policyActionBtn");
      if (btn) {
        btn.innerHTML = `<i class="fas fa-edit text-[10px]"></i> Update Policy`;
        btn.onclick = openEditModal;
      }
    } catch (err) {
      showToast(err.message || "Failed to load Privacy Policy", "error");
      const btn = document.getElementById("policyActionBtn");
      if (btn) {
        btn.innerHTML = `<i class="fas fa-plus text-[10px]"></i> Create Policy`;
        btn.onclick = openEditModal;
      }
    }
  }

  function renderPolicy() {
    const container = document.getElementById("policyContainer");
    container.innerHTML = '';

    if (!policyData.length) {
      container.innerHTML = `<p class="text-gray-500 font-semibold">Policy Not Found. Please create...`;
      return;
    }

    policyData.forEach((sec, index) => {
      const wrapper = document.createElement('section');
      wrapper.className = "py-2 first:pt-0 border-b border-slate-200 last:border-b-0";

      const cleanContent = sec.content
        .replace(/<br\s*\/?>/gi, '')
        .replace(/<p>\s*<\/p>/gi, '')
        .replace(/<div>\s*<\/div>/gi, '');

      wrapper.innerHTML = `
      <h3 class="font-bold text-lg text-blue-800 mb-2 mt-1 leading-tight">${sec.title}</h3>
      <div class="text-sm text-gray-700 leading-5 prose prose-sm max-w-none m-0 p-0 [&_*]:m-0 [&_*]:p-0 [&_p]:m-0 [&_p]:mb-1 [&_p]:leading-5 [&_br]:hidden [&_p:empty]:hidden">
        ${cleanContent}
      </div>
    `;
      container.appendChild(wrapper);
    });
  }

  async function openEditModal() {
    initPolicyEditor();

    try {
      await new Promise(resolve => {
        const check = () => policyEditorInstance ? resolve() : setTimeout(check, 50);
        check();
      });

      const btn = document.getElementById("policyActionBtn");
      const isCreateMode = !policyData.length || (btn && btn.innerHTML.includes("Create"));

      if (isCreateMode) {
        document.getElementById("modalTitle").textContent = "Create Privacy Policy";
        const editable = policyEditorInstance.ui.view.editable.element;
        editable.style.maxHeight = '450px';  
        editable.style.minHeight = '400px'; 
        policyEditorInstance.setData('');
      } else {
        document.getElementById("modalTitle").textContent = "Edit Privacy Policy";
        const editable = policyEditorInstance.ui.view.editable.element;
        editable.style.maxHeight = '320px';  
        editable.style.minHeight = '300px';  

        let combinedHTML = '';
        policyData.forEach(sec => {
          combinedHTML += `<h3>${sec.title}</h3><div>${sec.content}</div>`;
        });
        combinedHTML = combinedHTML
          .replace(/<br\s*\/?>\s*/gi, '')
          .replace(/<p>\s*<\/p>/gi, '')
          .replace(/<div>\s*<\/div>/gi, '')
          .replace(/\n\s*\n/g, '\n')
          .trim();

        policyEditorInstance.setData(combinedHTML);
      }

      document.getElementById("editModal").classList.remove("hidden");
      document.getElementById("editModal").classList.add("flex");

    } catch (err) {
      showToast(err.message || "Failed to prepare editor", "error");
    }
  }

  function closeEditModal() {
    document.getElementById("editModal").classList.add("hidden");
    document.getElementById("editModal").classList.remove("flex");
  }

  function loadSampleData() {
    policyEditorInstance.setData(`
<h3>Introduction</h3>
<p>
This Privacy Policy explains how we collect, use, and protect your information when you use our website or services. It also outlines your rights regarding your personal data. By using our services, you consent to the practices described in this policy. We are committed to maintaining your trust and ensuring your data is handled responsibly.
</p>

<h3>Data Collection</h3>
<p>
We collect personal information such as your name, email address, phone number, billing details, and usage data. Usage data may include IP address, browser type, pages visited, and time spent on our website. This information helps us improve our services, deliver personalized experiences, process transactions, and communicate important updates or promotional offers. We only collect data necessary for the functionality and enhancement of our services.
</p>

<h3>Cookies</h3>
<p>
Our website uses cookies, web beacons, and similar tracking technologies to improve user experience. Cookies help remember your preferences, login details, and language settings. We may also use cookies for analytics to understand site traffic patterns, optimize performance, and identify errors. You can manage or disable cookies through your browser settings, though some website features may not function properly without them.
</p>

<h3>Third-Party Services</h3>
<p>
We may share your information with trusted third-party service providers for analytics, marketing, payment processing, or customer support. These partners are carefully selected and required to maintain confidentiality and adhere to strict data protection standards. We do not sell or trade your personal information to unrelated third parties for marketing purposes.
</p>

<h3>Data Security</h3>
<p>
We employ technical, administrative, and physical security measures to protect your personal information. These measures include encryption of sensitive data, secure storage systems, firewalls, and restricted access controls. Despite these efforts, no system can be completely secure, so we encourage you to take precautions such as keeping your passwords confidential and reporting suspicious activity immediately.
</p>

<h3>User Rights</h3>
<p>
You have rights regarding your personal information, including the right to access, correct, delete, or restrict the use of your data. You may also object to processing or request data portability. Requests can be made through our support channels, and we will respond in accordance with applicable laws. You can also unsubscribe from promotional communications at any time.
</p>

<h3>Changes to This Policy</h3>
<p>
We may update this Privacy Policy periodically to reflect changes in our practices or legal requirements. We will post the updated policy on our website with a revised effective date. We encourage you to review this policy regularly to stay informed about how we protect your information.
</p>

<h3>Contact Us</h3>
<p>
If you have any questions, concerns, or requests regarding this Privacy Policy, you can contact us at privacy@yourcompany.com or through our contact/support page. Our team is committed to responding to inquiries promptly and addressing any concerns regarding your personal data.
</p>
  `);
    showToast("Sample data loaded! Edit and save.", "success");
  }

  function clearEditorData() {
    policyEditorInstance.setData('');
    showToast("Editor cleared!", "success");
  }

  async function savePolicy(e) {
    e.preventDefault();

    if (!policyEditorInstance) {
      showToast("Editor not ready", "error");
      return;
    }

    let rawHTML = policyEditorInstance.getData()
      .replace(/<br\s*\/?>\s*/gi, '')
      .replace(/<p>\s*<\/p>/gi, '')
      .replace(/<div>\s*<\/div>/gi, '')
      .trim();

    console.log('🔍 Raw HTML:', rawHTML.substring(0, 200) + '...');

    if (!rawHTML) {
      showToast("Policy cannot be empty", "error");
      return;
    }

    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = rawHTML;

    const sections = [];

    const h3Elements = tempDiv.querySelectorAll('h3');
    console.log('🔍 Found H3s:', h3Elements.length);

    if (h3Elements.length > 0) {
      h3Elements.forEach((h3) => {
        const title = h3.innerText.trim();
        if (!title) return;

        let content = '';
        let nextEl = h3.nextElementSibling;
        while (nextEl && nextEl.tagName !== 'H3') {
          content += nextEl.outerHTML;
          nextEl = nextEl.nextElementSibling;
        }

        if (content.trim()) {
          sections.push({ title, content: content.trim() });
        }
      });
    }

    if (sections.length === 0) {
      const allContent = tempDiv.innerHTML.trim();
      if (allContent) {
        sections.push({
          title: "Privacy Policy",
          content: allContent
        });
      }
    }

    console.log('🔍 Final sections:', sections);

    if (!sections.length) {
      showToast("At least one section with content is required", "error");
      return;
    }

    const spinner = document.getElementById("saveSpinner");
    const btnText = document.getElementById("saveBtnText");
    spinner.classList.remove("hidden");
    btnText.textContent = "Saving...";

    const submitBtn = e.target.querySelector('button[type="submit"]');
    submitBtn.disabled = true;

    const minLoadTime = new Promise(resolve => setTimeout(resolve, 3000));

    try {
      const response = await Promise.all([
        fetch("/api/privacypolicy/upsert", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ sections, isActive: true })
        }),
        minLoadTime
      ]);

      const apiResponse = await response[0].json();

      if (!apiResponse.success) {
        throw new Error(apiResponse.message || "Failed to save");
      }

      policyData = apiResponse.data.sections || [];
      renderPolicy();
      closeEditModal();
      showToast("Privacy Policy saved successfully!");

      const btn = document.getElementById("policyActionBtn");
      if (btn) {
        btn.innerHTML = `<i class="fas fa-edit text-[10px]"></i> Update Policy`;
        btn.onclick = openEditModal;
      }

    } catch (err) {
      console.error("Save error:", err);
      showToast(err.message || "Failed to save policy", "error");
    } finally {
      setTimeout(() => {
        spinner.classList.add("hidden");
        btnText.textContent = "Save";
        submitBtn.disabled = false;
      }, 3100);
    }
  }

  function showToast(msg, type = "success") {
    const toast = document.getElementById("toast");
    toast.textContent = msg;
    toast.className = `fixed top-3 right-6 px-4 py-2 rounded shadow z-50 text-white text-sm ${type === "success" ? "bg-green-600" : "bg-red-600"
      }`;
    toast.classList.remove("hidden");
    setTimeout(() => toast.classList.add("hidden"), 3000);
  }

  document.addEventListener("DOMContentLoaded", fetchPolicy);
</script>