<div class="min-h-screen bg-white p-6">
  <!-- HEADER -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-3">
    <div>
      <h1 class="text-3xl font-bold text-black-900 tracking-tight flex items-center gap-4 drop-shadow-md">
        <i class="fas fa-file-contract text-black-400 animate-pulse"></i>
        <span>Terms & Conditions</span>
      </h1>
    </div>
    <% if (user.role==='admin' ) { %>
      <div id="termsActionBtnContainer">
        <button id="termsActionBtn" onclick="openEditModal()"
          class="px-4 py-2 text-xs rounded bg-yellow-500 text-white hover:bg-yellow-600 transition flex items-center gap-2">
          Loading...
        </button>
      </div>
      <% } %>
  </div>

  <!-- TERMS CONTENT -->
  <div id="termsContainer" class="space-y-3 [&>section]:space-y-2 [&>div]:space-y-1"></div>

  <!-- EDIT MODAL - CREATE/UPDATE  -->
  <% if (user.role==='admin' ) { %>
    <div id="editModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
      <div class="bg-white w-full max-w-4xl max-h-[90vh] rounded-xl shadow-2xl flex flex-col">
        <div class="flex justify-between items-center p-6 border-b border-gray-200 shrink-0">
          <h2 id="modalTitle" class="text-lg font-bold text-gray-800">Edit Terms & Conditions</h2>
          <button onclick="closeEditModal()" class="text-gray-500 hover:text-red-500 p-2 hover:bg-gray-100 rounded">
            <i class="fas fa-times text-lg"></i>
          </button>
        </div>

        <!-- SCROLLABLE FORM -->
        <div class="flex-1 overflow-hidden flex flex-col max-h-[70vh]">
          <form id="editForm" onsubmit="saveTerms(event)" class="flex-1 flex flex-col overflow-hidden h-full">
            <!-- EDITOR CONTAINER  -->
            <div class="flex-1 overflow-y-auto p-6 border-b bg-gray-50/50 min-h-[400px]">
              <label class="block text-xs font-medium text-gray-700 mb-3 pb-1">Terms Content</label>

              <!-- HELPER BUTTONS -->
              <div class="mb-4 flex flex-wrap gap-2">
                <button type="button" onclick="loadSampleTermsData()"
                  class="px-4 py-2 text-xs bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-1 shadow-sm transition duration-300">
                  Load Sample
                </button>
                <button type="button" onclick="clearTermsEditorData()"
                  class="px-4 py-2 text-xs bg-gray-600 text-white rounded-lg hover:bg-gray-700 flex items-center gap-1 shadow-sm transition duration-300">
                  Clear
                </button>
              </div>

              <div class="w-full h-[450px]">
                <textarea id="termsEditor" class="w-full h-full"></textarea>
              </div>
            </div>

            <!-- BUTTONS -->
            <div class="p-6 border-t bg-white flex justify-end gap-2 pt-4 shrink-0">
              <button type="submit"
                class="px-5 py-2 text-[12px] rounded bg-blue-600 text-white hover:bg-blue-700 transition flex items-center gap-2">
                <svg id="saveSpinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg"
                  fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                </svg>
                <span id="saveBtnText">Save</span>
              </button>
              <button type="button" onclick="closeEditModal()"
                class="px-5 py-2 text-[12px] rounded bg-gray-400 text-white hover:bg-gray-500">Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <% } %>

      <div id="toast" class="fixed top-3 right-6 px-4 py-2 rounded shadow hidden z-50 text-white text-sm"></div>
</div>

<style>
  #termsContainer * {
    line-height: 1.4 !important;
    margin-bottom: 0.125em !important;
  }

  #termsContainer br {
    display: none !important;
  }

  #termsContainer p:empty {
    display: none !important;
  }

  #editModal .ck-editor__editable_inline,
  #editModal .ck-content {
    line-height: 1.4 !important;
    padding: 12px 16px !important;
    margin: 0 !important;
    overflow-y: auto !important;
    scrollbar-width: thin;
    max-height: 390px !important;
    min-height: 350px !important;
  }

  #editModal .ck-content::-webkit-scrollbar {
    width: 6px;
  }

  #editModal .ck-content::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 3px;
  }

  #editModal .ck-content::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }

  #editModal .ck-content::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  #editModal .ck-content p {
    margin-bottom: 0.125em !important;
    margin-top: 0 !important;
  }

  #editModal .ck-content br {
    display: none !important;
  }

  #editModal .ck-content h3 {
    margin: 0.5em 0 0.25em 0 !important;
    font-size: 1.125rem !important;
    color: #000000 !important;
    font-weight: 600 !important; 
  }

  #editModal #termsEditor {
    height: 100% !important;
    min-height: 350px !important;
  }
</style>

<script>
  let termsData = [];
  let termsEditorInstance;

  /* ---------------- INIT TERMS EDITOR ---------------- */
  function initTermsEditor() {
    if (termsEditorInstance) return;

    ClassicEditor
      .create(document.querySelector('#termsEditor'), {
        placeholder: 'Write your Terms & Conditions here...',
        toolbar: [
          'undo', 'redo', '|', 'heading', '|',
          'bold', 'italic', 'link', 'bulletedList', 'numberedList', '|',
          'blockQuote', 'insertTable', 'mediaEmbed', '|',
          'alignment', 'removeFormat'
        ],
        heading: {
          options: [
            { model: 'paragraph', title: 'Paragraph', class: 'ck-heading_paragraph' },
            { model: 'heading3', view: 'h3', title: 'Heading 3', class: 'ck-heading_h3' }
          ]
        },
        contentStyle: `
        * { margin: 0 !important; padding: 0 !important; line-height: 1.4 !important; }
        h3 { font-weight: bold; color: #1e40af; margin: 0 0 0.25em 0 !important; }
        p { font-size: 0.875rem; color: #374151; margin: 0 0 0.125em 0 !important; }
        br { display: none !important; }
        strong { font-weight: bold; }
        a { color: #1d4ed8; text-decoration: underline; }
        ul, ol { padding-left: 1.5rem; margin: 0.25em 0 !important; }
        li { margin-bottom: 0.125em !important; }
      `
      })
      .then(editor => {
        termsEditorInstance = editor;
        const editable = editor.ui.view.editable.element;
        editable.style.maxHeight = '320px';
        editable.style.minHeight = '300px';
        editable.style.overflowY = 'auto';
      })
      .catch(err => console.error("CKEditor init error:", err));
  }

  /* ---------------- FETCH TERMS ---------------- */
  async function fetchTerms() {
    try {
      const res = await fetch("/api/terms-conditions/view", { headers: { Accept: "application/json" } });
      const data = await res.json();

      if (!data.success) {
        const btn = document.getElementById("termsActionBtn");
        if (btn) {
          btn.innerHTML = `<i class="fas fa-plus text-[10px]"></i> Create Terms`;
          btn.onclick = openEditModal;
        }
        termsData = [];
        renderTerms();
        return;
      }

      termsData = data.data.sections || [];
      renderTerms();

      const btn = document.getElementById("termsActionBtn");
      if (btn) {
        btn.innerHTML = `<i class="fas fa-edit text-[10px]"></i> Update Terms`;
        btn.onclick = openEditModal;
      }
    } catch (err) {
      showToast(err.message || "Failed to load Terms & Conditions", "error");
      const btn = document.getElementById("termsActionBtn");
      if (btn) {
        btn.innerHTML = `<i class="fas fa-plus text-[10px]"></i> Create Terms`;
        btn.onclick = openEditModal;
      }
    }
  }

  /* ---------------- RENDER TERMS ---------------- */
  function renderTerms() {
    const container = document.getElementById("termsContainer");
    container.innerHTML = '';

    if (!termsData.length) {
      container.innerHTML = `<p class="text-gray-500 font-semibold">Terms Not Found. Please create...`;
      return;
    }

    termsData.forEach((sec, index) => {
      const wrapper = document.createElement('section');
      wrapper.className = "py-2 first:pt-0 border-b border-slate-200 last:border-b-0";

      const cleanContent = sec.content
        .replace(/<br\s*\/?>/gi, '')
        .replace(/<p>\s*<\/p>/gi, '')
        .replace(/<div>\s*<\/div>/gi, '');

      wrapper.innerHTML = `
        <h3 class="font-bold text-lg text-gray-800 mb-2 mt-1 leading-tight">${sec.title}</h3>
        <div class="text-sm text-gray-700 leading-5 prose prose-sm max-w-none m-0 p-0 [&_*]:m-0 [&_*]:p-0 [&_p]:m-0 [&_p]:mb-1 [&_p]:leading-5 [&_br]:hidden [&_p:empty]:hidden">
          ${cleanContent}
        </div>
      `;
      container.appendChild(wrapper);
    });
  }

  /* ---------------- OPEN EDIT MODAL ---------------- */
  async function openEditModal() {
    initTermsEditor();

    try {
      await new Promise(resolve => {
        const check = () => termsEditorInstance ? resolve() : setTimeout(check, 50);
        check();
      });

      const btn = document.getElementById("termsActionBtn");
      const isCreateMode = !termsData.length || (btn && btn.innerHTML.includes("Create"));

      if (isCreateMode) {
        document.getElementById("modalTitle").textContent = "Create Terms & Conditions";
        const editable = termsEditorInstance.ui.view.editable.element;
        editable.style.maxHeight = '450px';
        editable.style.minHeight = '400px';
        termsEditorInstance.setData('');
      } else {
        document.getElementById("modalTitle").textContent = "Edit Terms & Conditions";
        const editable = termsEditorInstance.ui.view.editable.element;
        editable.style.maxHeight = '320px';
        editable.style.minHeight = '300px';

        let combinedHTML = '';
        termsData.forEach(sec => {
          combinedHTML += `<h3>${sec.title}</h3><div>${sec.content}</div>`;
        });
        combinedHTML = combinedHTML
          .replace(/<br\s*\/?>\s*/gi, '')
          .replace(/<p>\s*<\/p>/gi, '')
          .replace(/<div>\s*<\/div>/gi, '')
          .replace(/\n\s*\n/g, '\n')
          .trim();

        termsEditorInstance.setData(combinedHTML);
      }

      document.getElementById("editModal").classList.remove("hidden");
      document.getElementById("editModal").classList.add("flex");

    } catch (err) {
      showToast(err.message || "Failed to prepare editor", "error");
    }
  }

  /* ---------------- CLOSE EDIT MODAL ---------------- */
  function closeEditModal() {
    document.getElementById("editModal").classList.add("hidden");
    document.getElementById("editModal").classList.remove("flex");
  }

  /* ---------------- LOAD SAMPLE TERMS DATA ---------------- */
  function loadSampleTermsData() {
    termsEditorInstance.setData(`
<h3>Acceptance of Terms</h3>
<p>
By accessing and using this website or our services, you agree to be bound by these Terms & Conditions, our Privacy Policy, and all applicable laws and regulations. If you do not agree with any part of these terms, you must not use our services. We reserve the right to modify these terms at any time, and continued use constitutes acceptance of changes.
</p>

<h3>User Accounts</h3>
<p>
To access certain features, you may need to create an account. You agree to provide accurate information and keep your account credentials confidential. You are responsible for all activities conducted through your account. Notify us immediately of any unauthorized use. We reserve the right to suspend or terminate accounts for violations of these terms.
</p>

<h3>Prohibited Activities</h3>
<p>
You agree not to use our services for illegal purposes, to transmit malware, spam, or harmful content, or to interfere with our systems. Prohibited activities include harassment, fraud, unauthorized access to systems, and posting objectionable content. We may terminate access and report violations to authorities as required by law.
</p>

<h3>Intellectual Property</h3>
<p>
All content, trademarks, logos, and materials on this website are owned by us or our licensors. You may not reproduce, distribute, or create derivative works without prior written permission. Limited personal, non-commercial use is permitted, but commercial use requires our express approval.
</p>

<h3>Payments and Billing</h3>
<p>
All payments are processed securely through authorized payment gateways. You agree to pay all applicable fees and taxes. We are not responsible for payment processing errors outside our control. Refunds are subject to our refund policy. Subscription services auto-renew unless cancelled.
</p>

<h3>Limitation of Liability</h3>
<p>
Our services are provided "as is" without warranties. We are not liable for indirect, consequential, or incidental damages. Our total liability shall not exceed the amount paid by you in the past 12 months. This limitation applies to the fullest extent permitted by law.
</p>

<h3>Termination</h3>
<p>
We may terminate or suspend your access at any time for violations of these terms or for business reasons. Upon termination, your right to use our services ends immediately. Certain provisions survive termination, including payment obligations, intellectual property rights, and liability limitations.
</p>

<h3>Governing Law</h3>
<p>
These terms are governed by the laws of [Your Jurisdiction]. Any disputes shall be resolved exclusively in the courts of [Your Jurisdiction]. You agree to submit to the personal jurisdiction of these courts.
</p>

<h3>Contact Us</h3>
<p>
For questions about these Terms & Conditions, please contact us at [support@yourcompany.com](mailto:support@yourcompany.com) or through our contact page. We aim to respond to inquiries within 48 hours.
</p>
    `);
    showToast("Sample Terms data loaded! Edit and save.", "success");
  }

  /* ---------------- CLEAR TERMS EDITOR DATA ---------------- */
  function clearTermsEditorData() {
    termsEditorInstance.setData('');
    showToast("Editor cleared!", "success");
  }

  /* ---------------- SAVE TERMS ---------------- */
  async function saveTerms(e) {
    e.preventDefault();

    if (!termsEditorInstance) {
      showToast("Editor not ready", "error");
      return;
    }

    let rawHTML = termsEditorInstance.getData()
      .replace(/<br\s*\/?>\s*/gi, '')
      .replace(/<p>\s*<\/p>/gi, '')
      .replace(/<div>\s*<\/div>/gi, '')
      .trim();


    if (!rawHTML) {
      showToast("Terms cannot be empty", "error");
      return;
    }

    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = rawHTML;

    const sections = [];

    const h3Elements = tempDiv.querySelectorAll('h3');

    if (h3Elements.length > 0) {
      h3Elements.forEach((h3) => {
        const title = h3.innerText.trim();
        if (!title) return;

        let content = '';
        let nextEl = h3.nextElementSibling;
        while (nextEl && nextEl.tagName !== 'H3') {
          content += nextEl.outerHTML;
          nextEl = nextEl.nextElementSibling;
        }

        if (content.trim()) {
          sections.push({ title, content: content.trim() });
        }
      });
    }

    if (sections.length === 0) {
      const allContent = tempDiv.innerHTML.trim();
      if (allContent) {
        sections.push({
          title: "Terms & Conditions",
          content: allContent
        });
      }
    }


    if (!sections.length) {
      showToast("At least one section with content is required", "error");
      return;
    }

    const spinner = document.getElementById("saveSpinner");
    const btnText = document.getElementById("saveBtnText");
    spinner.classList.remove("hidden");
    btnText.textContent = "Saving...";

    const submitBtn = e.target.querySelector('button[type="submit"]');
    submitBtn.disabled = true;

    const minLoadTime = new Promise(resolve => setTimeout(resolve, 3000));

    try {
      const response = await Promise.all([
        fetch("/api/terms-conditions/upsert", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ sections, isActive: true })
        }),
        minLoadTime
      ]);

      const apiResponse = await response[0].json();

      if (!apiResponse.success) {
        throw new Error(apiResponse.message || "Failed to save");
      }

      termsData = apiResponse.data.sections || [];
      renderTerms();
      closeEditModal();
      showToast("Terms & Conditions saved successfully!");

      const btn = document.getElementById("termsActionBtn");
      if (btn) {
        btn.innerHTML = `<i class="fas fa-edit text-[10px]"></i> Update Terms`;
        btn.onclick = openEditModal;
      }

    } catch (err) {
      console.error("Save error:", err);
      showToast(err.message || "Failed to save terms", "error");
    } finally {
      setTimeout(() => {
        spinner.classList.add("hidden");
        btnText.textContent = "Save";
        submitBtn.disabled = false;
      }, 3100);
    }
  }

  /* ---------------- SHOW TOAST ---------------- */
  function showToast(msg, type = "success") {
    const toast = document.getElementById("toast");
    toast.textContent = msg;
    toast.className = `fixed top-3 right-6 px-4 py-2 rounded shadow z-50 text-white text-sm ${type === "success" ? "bg-green-600" : "bg-red-600"}`;
    toast.classList.remove("hidden");
    setTimeout(() => toast.classList.add("hidden"), 3000);
  }

  /* ---------------- DOM CONTENT LOADED ---------------- */
  document.addEventListener("DOMContentLoaded", fetchTerms);
</script>