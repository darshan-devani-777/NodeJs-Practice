<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-slate-100 p-6">
        <!-- HEADER -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-10 gap-4">

            <!-- LEFT SIDE -->
            <div>
                <h1
                    class="text-3xl sm:text-4xl font-extrabold text-blue-900 tracking-tight flex items-center gap-3 mb-2">
                    <i class="fas fa-box-open text-orange-400 animate-pulse"></i>
                    <span>Orders Management</span>
                </h1>

                <p class="text-sm sm:text-base text-gray-600 font-medium">
                    View all orders, track status & manage delivery
                </p>
            </div>

            <!-- RIGHT SIDE BUTTONS -->
            <div class="flex flex-wrap gap-3">

                <!-- REFUND BUTTON -->
                <button onclick="scrollToRefund()" class="flex items-center gap-2 bg-red-600 text-white px-4 py-2 rounded-lg 
                   text-sm font-semibold hover:bg-red-700 transition shadow-sm">

                    <i class="fas fa-undo"></i>
                    <span>Refunds</span>
                </button>

            </div>

        </div>

        <!-- STATS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-10">
            <div
                class="bg-gradient-to-br from-orange-400 via-orange-500 to-orange-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-orange-100 font-bold">Total Orders</p>
                        <span id="totalOrders"
                            class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                    </div>
                    <i
                        class="fas fa-shopping-bag text-5xl text-orange-200 opacity-80 group-hover:scale-125 transition"></i>
                </div>
            </div>

            <div
                class="bg-gradient-to-br from-yellow-400 via-yellow-500 to-yellow-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-yellow-100 font-bold">Pending</p>
                        <span id="pendingOrders"
                            class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                    </div>
                    <i class="fas fa-clock text-5xl text-yellow-200 opacity-80 group-hover:scale-125 transition"></i>
                </div>
            </div>

            <div
                class="bg-gradient-to-br from-green-400 via-green-500 to-green-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-green-100 font-bold">Delivered</p>
                        <span id="deliveredOrders"
                            class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                    </div>
                    <i
                        class="fas fa-check-circle text-5xl text-green-200 opacity-80 group-hover:scale-125 transition"></i>
                </div>
            </div>

            <div
                class="bg-gradient-to-br from-purple-400 via-purple-500 to-purple-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-purple-100 font-bold">Total Revenue</p>
                        <span id="totalRevenue"
                            class="text-2xl sm:text-3xl font-bold text-white font-mono animate-pulse leading-tight">₹0</span>
                    </div>
                    <i
                        class="fas fa-rupee-sign text-4xl sm:text-5xl text-purple-200 opacity-80 group-hover:scale-125 transition"></i>
                </div>
            </div>
        </div>

        <!-- SEARCH + FILTER -->
        <div class="w-full mb-4">
            <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:gap-3">

                <!-- 🔍 Search -->
                <div class="w-full lg:w-64">
                    <input type="text" id="searchInput" placeholder="🔍 Search order#, customer..." class="w-full border border-gray-300 rounded-md px-3 py-2 text-xs bg-white
                        focus:outline-none focus:ring-2 focus:ring-orange-400 shadow-sm transition-all" />
                </div>

                <!-- Filters -->
                <div class="flex flex-wrap gap-2 w-full lg:flex-1">

                    <select id="statusFilter" class="flex-1 min-w-[110px] border border-gray-300 rounded-md px-2 py-2 text-xs bg-white
                        focus:outline-none focus:ring-2 focus:ring-orange-400 shadow-sm">
                        <option value="all">All Status</option>
                        <option value="pending">Pending</option>
                        <option value="processing">Processing</option>
                        <option value="shipped">Shipped</option>
                        <option value="delivered">Delivered</option>
                        <option value="cancelled">Cancelled</option>
                    </select>

                    <select id="paymentFilter" class="flex-1 min-w-[110px] border border-gray-300 rounded-md px-2 py-2 text-xs bg-white
                        focus:outline-none focus:ring-2 focus:ring-orange-400 shadow-sm">
                        <option value="all">All Payments</option>
                        <option value="pending">Pending</option>
                        <option value="paid">Paid</option>
                        <option value="failed">Failed</option>
                        <option value="refunded">Refunded</option>
                    </select>

                    <select id="sortSelect" class="flex-1 min-w-[120px] border border-gray-300 rounded-md px-2 py-2 text-xs bg-white
                        focus:outline-none focus:ring-2 focus:ring-orange-400 shadow-sm">
                        <option value="desc">Newest</option>
                        <option value="asc">Oldest</option>
                        <option value="total-desc">High Amount</option>
                        <option value="total-asc">Low Amount</option>
                    </select>

                    <!-- Button -->
                    <button onclick="onSearch()" class="px-4 py-2 text-xs font-semibold text-white bg-orange-600 rounded-md
                        hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-400
                        shadow-sm whitespace-nowrap">
                        <i class="fas fa-search mr-1"></i> Filter
                    </button>

                </div>
            </div>
        </div>

        <!-- TABLE -->
        <div class="bg-white rounded-xl shadow-lg border border-orange-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm table-auto">
                    <thead class="bg-gradient-to-r from-orange-50 via-orange-100 to-white sticky top-0">
                        <tr class="text-left text-orange-700">
                            <th class="px-3 py-3 text-xs font-bold text-orange-700 text-center min-w-[45px] w-[45px]">#
                            </th>
                            <th class="px-3 py-3 text-xs font-bold text-center min-w-[130px]">Order Number</th>
                            <th class="px-4 py-3 text-xs font-bold text-centermin-w-[140px]">Customer</th>
                            <th class="px-3 py-3 text-xs font-bold text-center min-w-[85px]">Status</th>
                            <th class="px-3 py-3 text-xs font-bold text-center min-w-[70px]">Items</th>
                            <th class="px-3 py-3 text-xs font-bold text-center min-w-[90px]">Amount</th>
                            <th class="px-3 py-3 text-xs font-bold text-center min-w-[85px]">Payment
                            </th>
                            <th class="px-3 py-3 text-xs font-bold text-center min-w-[85px]">Created
                            </th>
                            <th class="px-3 py-3 text-xs font-bold text-center min-w-[120px]">Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody id="ordersTable" class="divide-y divide-gray-100"></tbody>
                </table>
            </div>
        </div>

        <!-- ================= REFUND SECTION ================= -->
        <div id="refundSection" class="hidden mt-10">

            <!-- HEADER -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-3">

                <div>
                    <h1 class="text-3xl sm:text-4xl font-extrabold text-red-800 flex items-center gap-3 mb-2">
                        <i class="fas fa-undo text-red-500 animate-pulse"></i>
                        <span>Refund Management</span>
                    </h1>

                    <p class="text-sm text-gray-600 font-medium">
                        Manage refund requests, approve or process payments
                    </p>
                </div>

            </div>


            <!-- TABLE CARD -->
            <div class="bg-white rounded-xl shadow-lg border border-red-100 overflow-hidden">

                <!-- TABLE -->
                <div class="overflow-x-auto">
                    <table class="w-full text-sm min-w-[900px]">

                        <thead class="bg-red-50 sticky top-0 z-10">
                            <tr class="text-left text-red-700">
                                <th class="px-4 py-3 font-semibold">Refund ID</th>
                                <th class="px-4 py-3 font-semibold">Order</th>
                                <th class="px-4 py-3 font-semibold">User</th>
                                <th class="px-4 py-3 font-semibold text-center">Amount</th>
                                <th class="px-4 py-3 font-semibold">Reason</th>
                                <th class="px-4 py-3 font-semibold text-center">Status</th>
                                <th class="px-4 py-3 font-semibold text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="refundTable" class="divide-y divide-gray-100">
                        </tbody>

                    </table>
                </div>

                <!-- EMPTY STATE -->
                <div id="refundEmpty" class="hidden p-12 text-center text-gray-500">
                    <i class="fas fa-inbox text-4xl mb-3 block text-red-300"></i>
                    <p class="font-semibold">No refund requests found</p>
                </div>

            </div>
        </div>

        <div class="mt-6 text-center">
            <button id="loadMoreBtn" onclick="fetchOrders()"
                class="inline-flex items-center justify-center gap-1 bg-gray-400 text-white px-6 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-500 transition-all hidden w-full sm:w-auto shadow-sm">
                <i class="fas fa-arrow-down"></i> Load More
            </button>
        </div>

        <!-- ORDER DETAILS MODAL -->
        <div id="orderDetailsModal"
            class="fixed inset-0 bg-black/30 backdrop-blur-sm hidden flex items-center justify-center z-50 p-4">
            <div
                class="bg-white w-full max-w-lg max-h-[80vh] rounded-2xl shadow-2xl overflow-hidden border border-gray-200">
                <div
                    class="px-5 py-4 border-b flex justify-between items-center bg-gradient-to-r from-orange-50 to-yellow-50">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span
                            class="bg-orange-100 text-orange-800 px-3 py-1.5 rounded-full text-sm font-mono font-semibold shadow-sm"
                            id="modalOrderNumber">#ORD001</span>
                        <div class="flex items-center gap-2" id="modalOrderSummary"></div>
                    </div>
                    <button onclick="closeOrderModal()"
                        class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-200 transition-all text-gray-600 hover:text-orange-700">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="p-5 max-h-[50vh] overflow-y-auto">
                    <div class="grid grid-cols-1 gap-4 mb-5">
                        <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
                            <h4 class="font-semibold text-gray-800 mb-3 flex items-center gap-2 text-sm">
                                <i class="fas fa-user text-orange-500"></i> Customer Details
                            </h4>
                            <div id="modalCustomerInfo" class="space-y-1.5 text-sm"></div>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
                            <h4 class="font-semibold text-gray-800 mb-3 flex items-center gap-2 text-sm">
                                <i class="fas fa-map-marker-alt text-orange-500"></i> Delivery Address
                            </h4>
                            <div id="modalShippingAddress" class="space-y-1 text-sm"></div>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-4">
                        <div class="p-4 border-b bg-gray-50 rounded-t-xl">
                            <h4 class="font-semibold text-gray-800 flex items-center gap-2 text-sm">
                                <i class="fas fa-list text-orange-500"></i> Order Items
                                <span
                                    class="bg-orange-100 text-orange-800 px-2 py-1 rounded-full text-xs font-mono ml-2"
                                    id="modalItemCount">0</span>
                            </h4>
                        </div>
                        <div id="modalOrderItems" class="p-4 max-h-[220px] overflow-y-auto"></div>
                    </div>
                </div>
                <div class="px-5 py-4 border-t bg-gradient-to-r from-orange-50 to-yellow-50">
                    <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
                        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-700">
                            <span class="flex items-center gap-1 font-medium">
                                <i class="fas fa-credit-card text-orange-500"></i>
                                <span id="modalPaymentMethod">COD</span>
                            </span>
                            <span class="flex items-center gap-1">
                                <i class="fas fa-sticky-note text-blue-500"></i>
                                <span class="italic break-words" id="modalNotes">No notes</span>
                            </span>
                            <div id="modalTrackingInfo"
                                class="flex items-center gap-1.5 bg-blue-50 px-2.5 py-1 rounded-lg text-xs font-mono font-semibold text-blue-800 border border-blue-200">
                            </div>
                        </div>
                        <div class="text-xl font-black text-gray-900" id="modalGrandTotal">₹0</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- STATUS UPDATE MODAL -->
        <div id="statusUpdateModal"
            class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center z-[60] p-4"></div>

        <!-- TOAST -->
        <div id="toast" class="fixed top-3 right-6 px-4 py-2 rounded shadow hidden z-50 text-white text-sm">
        </div>
    </div>

    <script>
        let page = 1, search = "",
            statusFilter = "all",
            paymentFilter = "all",
            sort = "desc",
            indexOffset = 0;
        const limit = 10;
        let currentOrderId = null;
        let currentUpdatingOrderId = null;

        /* ================= SAFE PARSE JSON ================= */
        async function safeParseJSON(res) {
            const text = await res.text();
            console.log("API:", text);
            try { return JSON.parse(text); }
            catch { throw new Error("Invalid JSON"); }
        }

        /* ================= ANIMATE VALUE ================= */
        function animateNumber(id, start, end, prefix = "", duration = 800) {
            const el = document.getElementById(id);
            if (!el) return;
            let startTime = null;
            const step = (timestamp) => {
                if (!startTime) startTime = timestamp;
                const progress = Math.min((timestamp - startTime) / duration, 1);
                el.textContent = prefix + Math.floor(progress * (end - start) + start).toLocaleString('en-IN');
                if (progress < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        }

        /* ================= SHOW TOAST ================= */
        function showToast(msg, type = "success") {
            const toast = document.getElementById("toast");
            toast.textContent = msg;
            toast.className = `fixed top-3 right-6 px-4 py-2 rounded-lg shadow-lg z-50 text-white text-sm font-medium 
            ${type === "success" ? "bg-green-600" : "bg-red-600"}`;
            toast.classList.remove("hidden");
            setTimeout(() => toast.classList.add("hidden"), 3000);
        }

        /* ================= GET STATUS CLASS ================= */
        function getStatusClass(status) {
            const classes = {
                pending: 'bg-yellow-100 text-yellow-800 border border-yellow-200',
                processing: 'bg-blue-100 text-blue-800 border border-blue-200',
                shipped: 'bg-purple-100 text-purple-800 border border-purple-200',
                delivered: 'bg-green-100 text-green-800 border border-green-200',
                cancelled: 'bg-red-100 text-red-800 border border-red-200'
            };
            return classes[status] || 'bg-gray-100 text-gray-800 border border-gray-200';
        }

        /* ================= GET PAYMENT CLASS ================= */
        function getPaymentClass(status) {
            const classes = {
                pending: 'bg-yellow-100 text-yellow-800 border border-yellow-200',
                paid: 'bg-green-100 text-green-800 border border-green-200',
                failed: 'bg-red-100 text-red-800 border border-red-200',
                refunded: 'bg-orange-100 text-orange-800 border border-orange-200'
            };
            return classes[status] || 'bg-gray-100 text-gray-800 border border-gray-200';
        }

        /* ================= FETCH ORDER STATS ================= */
        async function fetchOrderStats() {
            try {
                const token = localStorage.getItem("token");

                const res = await fetch("/api/orders/stats", {
                    headers: {
                        Accept: "application/json",
                        "Authorization": `Bearer ${token}`
                    }
                });

                const { success, stats } = await safeParseJSON(res);

                if (!success) throw new Error();

                animateNumber("totalOrders", 0, stats.totalOrders || 0);
                animateNumber("pendingOrders", 0, stats.pendingOrders || 0);
                animateNumber("deliveredOrders", 0, stats.deliveredOrders || 0);
                animateNumber("totalRevenue", 0, stats.totalRevenue || 0, "₹");

            } catch (err) {
                document.getElementById("totalOrders").textContent = "0";
                document.getElementById("pendingOrders").textContent = "0";
                document.getElementById("deliveredOrders").textContent = "0";
                document.getElementById("totalRevenue").textContent = "₹0";
            }
        }

        /* ================= FETCH ORDERS ================= */
        async function fetchOrders(reset = false) {
            if (reset) {
                page = 1;
                indexOffset = 0;
                document.getElementById("ordersTable").innerHTML = "";
            }

            const params = new URLSearchParams({ page: page.toString(), limit: limit.toString() });
            if (search) params.append("search", search);
            if (statusFilter !== "all") params.append("status", statusFilter);
            if (paymentFilter !== "all") params.append("paymentStatus", paymentFilter);
            if (sort !== "desc") params.append("sort", sort);

            try {
                const res = await fetch(`/api/orders/all-orders?${params}`, { headers: { Accept: "application/json" } });
                const data = await safeParseJSON(res);
                if (!data.success) throw new Error(data.message || "Failed");

                const tbody = document.getElementById("ordersTable");
                const loadMoreBtn = document.getElementById("loadMoreBtn");
                const orders = data.data || [];

                if (reset && orders.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="9" class="text-center py-16 text-gray-500"><i class="fas fa-inbox text-4xl mb-3 block"></i><div class="font-semibold text-lg">No orders found</div></td></tr>`;
                    loadMoreBtn.classList.add("hidden");
                    return;
                }

                orders.forEach((order, i) => {
                    const tr = document.createElement("tr");
                    tr.className = "border-b border-orange-50";
                    tr.dataset.id = order._id;

                    const statusBadge = `<span class="px-2.5 py-1 rounded-full text-xs font-semibold shadow-sm border ${getStatusClass(order.status)}">${order.status}</span>`;
                    const paymentBadge = `<span class="px-2 py-1 rounded-full text-xs font-semibold shadow-sm border ${getPaymentClass(order.paymentStatus)}">${order.paymentStatus}</span>`;

                    tr.innerHTML = `
                    <td class="px-3 py-4 text-center"><span class="font-mono text-orange-700 font-bold text-sm">${indexOffset + i + 1}.</span></td>
                    <td class="px-3 py-4"><span class="font-mono font-semibold text-orange-700 text-sm">${order.orderNumber}</span></td>
                    <td class="px-4 py-4">
                        <div class="font-semibold text-gray-800 text-sm truncate max-w-[120px]">${order.user?.name || 'Customer'}</div>
                        <div class="text-xs text-gray-500 truncate">${order.user?.email || order.shippingAddress?.phone || '-'}</div>
                    </td>
                    <td class="px-3 py-4 text-center">${statusBadge}</td>
                    <td class="px-3 py-4 text-center"><span class="font-mono font-bold text-sm text-blue-600">${order.items.length}</span></td>
                    <td class="px-3 py-4 text-center"><span class="font-mono font-bold text-sm text-green-600">₹${order.totalAmount.toLocaleString('en-IN')}</span></td>
                    <td class="px-3 py-4 text-center">${paymentBadge}</td>
                    <td class="px-3 py-4 text-center text-xs font-mono">
                        <div>${order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-IN') : '-'}</div>
                        <div class="text-gray-500 text-[11px]">${order.createdAt ? new Date(order.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : ''}</div>
                    </td>
                    <td class="px-3 py-4 text-center">
                        <div class="flex items-center gap-1.5 justify-center">
                            <!-- View Button -->
                            <button onclick="event.stopPropagation(); openOrderModal('${order._id}')"
                                class="group/btn px-2 py-1 rounded-lg bg-orange-100 hover:bg-orange-200 text-orange-700 hover:text-orange-800 shadow-sm hover:shadow-md transition-all flex items-center justify-center" 
                                title="View Details">
                                <i class="fas fa-eye text-sm group-hover/btn:scale-110"></i>
                            </button>
                            <!-- Status Update Button -->
                            <button onclick="event.stopPropagation(); updateOrderStatus('${order._id}')"
                                class="group/btn px-2 py-1 rounded-lg bg-blue-100 hover:bg-blue-200 text-blue-700 hover:text-blue-800 shadow-sm hover:shadow-md transition-all flex items-center justify-center" 
                                title="Update Status">
                                <i class="fas fa-edit text-sm group-hover/btn:scale-110"></i>
                            </button>
                        </div>
                    </td>
                `;
                    tbody.appendChild(tr);
                });

                indexOffset += orders.length;
                page++;
                loadMoreBtn.classList.toggle("hidden", !data.pagination?.hasNextPage);
                if (reset) fetchOrderStats();

            } catch (e) {
                showToast("Failed to load orders. Please refresh!", "error");
                console.error(e);
            }
        }

        /* ================= SEARCH ================= */
        function onSearch() {
            search = document.getElementById("searchInput").value.trim();
            statusFilter = document.getElementById("statusFilter").value;
            paymentFilter = document.getElementById("paymentFilter").value;
            sort = document.getElementById("sortSelect").value;
            page = 1; indexOffset = 0;
            fetchOrders(true);
        }

        /* ================= CLOSE ORDER MODEL ================= */
        function closeOrderModal() {
            document.getElementById("orderDetailsModal").classList.add("hidden");
            currentOrderId = null;
        }

        /* ================= OPEN ORDER MODEL ================= */
        async function openOrderModal(orderId) {
            try {
                currentOrderId = orderId;
                const res = await fetch(`/api/orders/specific/${orderId}`, { headers: { Accept: "application/json" } });
                const data = await safeParseJSON(res);
                if (!data.success) throw new Error();

                const order = data.data;

                document.getElementById("modalOrderNumber").textContent = `#${order.orderNumber}`;
                document.getElementById("modalOrderSummary").innerHTML = `
                <span class="px-2 py-1 rounded-full text-xs font-semibold shadow-sm border ${getStatusClass(order.status)}">${order.status}</span>
                <span class="mx-1 text-xs text-gray-400">•</span>
                <span class="px-2 py-1 rounded-full text-xs font-semibold shadow-sm border ${getPaymentClass(order.paymentStatus)}">${order.paymentStatus}</span>
            `;

                document.getElementById("modalCustomerInfo").innerHTML = `
                <div class="font-bold text-base mb-2">${order.user?.name || 'Customer'}</div>
                ${order.user?.email ? `<div class="text-gray-600 bg-white px-2 py-1 rounded text-sm mb-2">${order.user.email}</div>` : ''}
                <div class="flex items-center gap-2 text-emerald-600 font-mono"><i class="fas fa-phone"></i>${order.shippingAddress.phone}</div>
            `;

                const address = order.shippingAddress;
                document.getElementById("modalShippingAddress").innerHTML = `
                <div class="font-bold mb-2">${address.fullName}</div>
                <div class="text-gray-700 mb-1">${address.address}</div>
                <div class="font-medium mb-1">${address.city}, ${address.state} ${address.postalCode}</div>
                <div class="text-gray-500 text-sm">${address.country}</div>
            `;

                const itemsContainer = document.getElementById("modalOrderItems");
                let grandTotal = 0;
                document.getElementById("modalItemCount").textContent = order.items.length;
                itemsContainer.innerHTML = "";

                order.items.forEach(item => {
                    const product = item.product;
                    const total = (item.price || 0) * item.quantity;
                    grandTotal += total;

                    const itemDiv = document.createElement("div");
                    itemDiv.className = "flex items-center gap-3 p-3 bg-gradient-to-r from-gray-50 to-white rounded-xl hover:bg-orange-50 border border-gray-100 hover:border-orange-200 transition-all mb-2";
                    itemDiv.innerHTML = `
                    <div class="w-14 h-14 rounded-lg overflow-hidden shadow-sm border">
                        <img src="${product?.image || 'https://via.placeholder.com/56x56/E5E7EB/FFFFFF?text=No+Img'}" alt="${product?.title}" class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm truncate mb-1">${product?.title || 'Product'}</div>
                        <div class="text-xs text-gray-600">Qty: ${item.quantity} × ₹${(item.price || 0).toLocaleString('en-IN')}</div>
                    </div>
                    <div class="font-bold text-sm text-emerald-600 min-w-[70px] text-right">₹${total.toLocaleString('en-IN')}</div>
                `;
                    itemsContainer.appendChild(itemDiv);
                });

                document.getElementById("modalPaymentMethod").textContent = order.paymentMethod?.toUpperCase() || 'COD';
                document.getElementById("modalNotes").textContent = order.notes || 'No notes';
                document.getElementById("modalGrandTotal").textContent = `₹${grandTotal.toLocaleString('en-IN')}`;

                const trackingHTML = order.trackingNumber
                    ? `<i class="fas fa-truck text-blue-500"></i> 
       <span class="font-semibold">${order.trackingNumber}</span>`
                    : `<i class="fas fa-clock text-gray-400"></i> 
       <span class="text-gray-500 font-medium">No tracking</span>`;

                const invoiceHTML = order.paymentStatus === "paid" && order.invoiceNumber
                    ? `<button 
           onclick="downloadInvoice('${order._id}')"
           class="flex items-center gap-1.5 bg-green-50 hover:bg-green-100 transition px-2.5 py-1 rounded-lg text-xs font-mono font-semibold text-green-800 border border-green-200 cursor-pointer"
           title="Download Invoice">
           
           <i class="fas fa-file-invoice text-green-600"></i> 
           ${order.invoiceNumber}
       </button>`
                    : "";

                document.getElementById("modalTrackingInfo").innerHTML = trackingHTML + invoiceHTML;

                document.getElementById("orderDetailsModal").classList.remove("hidden");

            } catch (err) {
                showToast("Failed to load order details", "error");
                console.error(err);
            }
        }

        /* ================= UPDATE ORDER STATUS ================= */
        async function updateOrderStatus(orderId) {
            currentUpdatingOrderId = orderId;

            try {
                const res = await fetch(`/api/orders/specific/${orderId}`, {
                    headers: { Accept: "application/json" }
                });
                const data = await safeParseJSON(res);
                if (!data.success) throw new Error();

                const order = data.data;
                showStatusUpdateModal(order);
            } catch (err) {
                showToast("Failed to load order for update", "error");
                console.error(err);
            }
        }

        /* ================= OPEN STATUS UPDATE MODEL ================= */
        function showStatusUpdateModal(order) {
            const statusOptions = ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
            const paymentOptions = ['pending', 'paid', 'failed', 'refunded'];

            const modalHTML = `
            <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden border border-gray-200 max-h-[90vh] overflow-y-auto">
                <div class="px-6 py-4 border-b bg-gradient-to-r from-blue-50 to-indigo-50">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="bg-blue-100 text-blue-800 px-3 py-1.5 rounded-full text-sm font-mono font-semibold">#${order.orderNumber}</span>
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold shadow-sm border ${getStatusClass(order.status)}">${order.status}</span>
                        </div>
                        <button onclick="closeStatusUpdateModal()" class="w-9 h-9 flex items-center justify-center rounded-xl hover:bg-gray-200 transition-all text-gray-600 hover:text-blue-700">
                            <i class="fas fa-times text-lg"></i>
                        </button>
                    </div>
                </div>
                
                <div class="p-6 space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fas fa-toggle-on text-blue-500"></i> Order Status
                        </label>
                        <select id="statusSelect" class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent shadow-sm transition-all">
                            ${statusOptions.map(s =>
                `<option value="${s}" ${order.status === s ? 'selected' : ''}>${s.charAt(0).toUpperCase() + s.slice(1)}</option>`
            ).join('')}
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fas fa-credit-card text-green-500"></i> Payment Status
                        </label>
                        <select id="paymentSelect" class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-transparent shadow-sm transition-all">
                            ${paymentOptions.map(p =>
                `<option value="${p}" ${order.paymentStatus === p ? 'selected' : ''}>${p.charAt(0).toUpperCase() + p.slice(1)}</option>`
            ).join('')}
                        </select>
                    </div>
                    
                    <div id="trackingField" style="display: none;">
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fas fa-truck text-purple-500"></i> Tracking Number
                        </label>
                        <input id="trackingInput" type="text" value="${order.trackingNumber || ''}" 
                               class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-purple-400 focus:border-transparent shadow-sm transition-all"
                               placeholder="Enter tracking number">
                    </div>
                </div>
                
                <div class="px-6 py-5 bg-gradient-to-r from-blue-50 to-indigo-50 border-t space-x-3 flex justify-end gap-3">
                    <button onclick="closeStatusUpdateModal()" 
                            class="px-6 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-400 shadow-sm transition-all">
                        Cancel
                    </button>
                   <button id="updateStatusBtn"
        onclick="submitStatusUpdate()" 
        class="px-6 py-2.5 text-sm font-bold text-white bg-blue-600 rounded-xl hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 shadow-lg hover:shadow-xl transition-all flex items-center gap-2 justify-center min-w-[140px]">
    <i class="fas fa-save"></i> 
    <span id="updateBtnText">Update Status</span>
</button>
                </div>
            </div>
        `;

            document.getElementById("statusUpdateModal").innerHTML = modalHTML;
            document.getElementById("statusUpdateModal").classList.remove("hidden");

            const statusSelect = document.getElementById('statusSelect');
            const trackingField = document.getElementById('trackingField');
            function toggleTracking() {
                trackingField.style.display = statusSelect.value === 'shipped' ? 'block' : 'none';
            }
            statusSelect.addEventListener('change', toggleTracking);
            toggleTracking();
        }

        /* ================= SUBMIT STATUS UPDATE ================= */
        async function submitStatusUpdate() {

            if (!currentUpdatingOrderId) {
                showToast("Order ID missing", "error");
                return;
            }

            const btn = document.getElementById("updateStatusBtn");
            const btnText = document.getElementById("updateBtnText");

            const status = document.getElementById('statusSelect').value;
            const paymentStatus = document.getElementById('paymentSelect').value;
            const trackingNumber = document.getElementById('trackingInput')?.value.trim();

            const token = localStorage.getItem("token");

            try {

                btn.disabled = true;
                btn.classList.remove("bg-blue-600", "hover:bg-blue-700");
                btn.classList.add("bg-blue-400", "cursor-not-allowed");

                btnText.innerHTML = `
        <i class="fas fa-spinner fa-spin"></i> Updating...
    `;

                const payload = {
                    status,
                    paymentStatus
                };

                if (status === "shipped") {
                    payload.trackingNumber = trackingNumber || "";
                }

                const res = await fetch(`/api/orders/${currentUpdatingOrderId}/status`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(payload)
                });

                const data = await safeParseJSON(res);

                if (data.success) {
                    showToast("Order updated successfully!", "success");
                    closeStatusUpdateModal();
                    fetchOrders(true);
                    fetchOrderStats();
                } else {
                    showToast(data.message || "Update failed", "error");
                }

            } catch (error) {
                showToast("Failed to update status", "error");
                console.error(error);
            } finally {

                btn.disabled = false;
                btn.classList.remove("bg-blue-400", "cursor-not-allowed");
                btn.classList.add("bg-blue-600");

                btnText.innerHTML = `
        <i class="fas fa-save"></i> Update Status
    `;
            }
        }

        /* ================= CLOSE STATUS UPDATE MODEL ================= */
        function closeStatusUpdateModal() {
            document.getElementById("statusUpdateModal").classList.add("hidden");
            currentUpdatingOrderId = null;
        }

        /* ================= DOM LOADED ================= */
        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("searchInput").addEventListener("keypress", e => e.key === "Enter" && onSearch());
            ["statusFilter", "paymentFilter", "sortSelect"].forEach(id =>
                document.getElementById(id).addEventListener("change", onSearch)
            );
            document.getElementById("orderDetailsModal").addEventListener("click", e => {
                if (e.target.id === "orderDetailsModal") closeOrderModal();
            });
            document.getElementById("statusUpdateModal").addEventListener("click", e => {
                if (e.target.id === "statusUpdateModal") closeStatusUpdateModal();
            });
            fetchOrders(true);
        });

        window.onSearch = onSearch;
        window.fetchOrders = fetchOrders;
        window.openOrderModal = openOrderModal;
        window.closeOrderModal = closeOrderModal;
        window.updateOrderStatus = updateOrderStatus;
        window.closeStatusUpdateModal = closeStatusUpdateModal;
        window.submitStatusUpdate = submitStatusUpdate;

        /* ================= TOGGLE REFUND SECTION ================= */
        function toggleRefundSection() {
            const section = document.getElementById("refundSection");
            section.classList.toggle("hidden");
            if (!section.classList.contains("hidden")) {
                fetchRefunds();
            }
        }

        /* ================= FETCH REFUNDS ================= */
        async function fetchRefunds() {
            try {
                const token = localStorage.getItem("token");

                const res = await fetch("/api/orders/refund/get-all-refunds", {
                    headers: {
                        Accept: "application/json",
                        Authorization: `Bearer ${token}`
                    }
                });

                const data = await res.json();
                if (!data.success) throw new Error();

                const tbody = document.getElementById("refundTable");
                const empty = document.getElementById("refundEmpty");

                tbody.innerHTML = "";

                if (!data.data.length) {
                    empty.classList.remove("hidden");
                    return;
                } else {
                    empty.classList.add("hidden");
                }

                data.data.forEach(refund => {

                    const tr = document.createElement("tr");
                    tr.className = "hover:bg-gray-50 transition";

                    tr.innerHTML = `
                <td class="px-4 py-3 font-mono text-xs break-all">
                    ${refund._id}
                </td>

                <td class="px-4 py-3 font-mono text-xs text-blue-600">
                    ${refund.order?.orderNumber || '-'}
                </td>

                <td class="px-4 py-3">
                    <div class="font-semibold">${refund.user?.name || '-'}</div>
                    <div class="text-xs text-gray-500">${refund.user?.email || ''}</div>
                </td>

                <td class="px-4 py-3 font-bold text-green-600">
                    ₹${refund.amount?.toLocaleString('en-IN')}
                </td>

                <td class="px-4 py-3 text-xs max-w-[200px] truncate">
                    ${refund.reason || '-'}
                </td>

                <td class="px-4 py-3">
                    <span class="px-2 py-1 rounded-full text-xs font-semibold ${getRefundStatusClass(refund.status)}">
                        ${refund.status}
                    </span>
                </td>
<td class="px-4 py-3 text-center">
    <div class="flex items-center justify-center gap-3">

        <button onclick="updateRefund('${refund._id}', 'approved')"
            class="text-green-600 hover:text-green-800 text-lg"
            title="Approve Refund">
            <i class="fas fa-check-circle"></i>
        </button>

        <button onclick="updateRefund('${refund._id}', 'rejected')"
            class="text-red-600 hover:text-red-800 text-lg"
            title="Reject Refund">
            <i class="fas fa-times-circle"></i>
        </button>

        <button onclick="updateRefund('${refund._id}', 'processed')"
            class="text-blue-600 hover:text-blue-800 text-lg"
            title="Process Refund">
            <i class="fas fa-check-double"></i>
        </button>

    </div>
</td>
            `;

                    tbody.appendChild(tr);
                });

            } catch (err) {
                showToast("Failed to load refunds", "error");
            }
        }

        /* ================= UPDATE REFUND ================= */
        async function updateRefund(refundId, status) {

            const token = localStorage.getItem("token");

            try {
                const res = await fetch(`/api/orders/refund/${refundId}`, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                        Authorization: `Bearer ${token}`
                    },
                    body: JSON.stringify({ status })
                });

                const data = await res.json();

                if (data.success) {
                    showToast("Refund updated successfully", "success");
                    fetchRefunds();
                    fetchOrderStats(); // refresh dashboard
                } else {
                    showToast(data.message, "error");
                }

            } catch (err) {
                showToast("Refund update failed", "error");
            }
        }

        /* ================= GET REFUND STATUS ================= */
        function getRefundStatusClass(status) {
            switch (status) {
                case "requested":
                    return "bg-yellow-100 text-yellow-800";
                case "approved":
                    return "bg-green-100 text-green-800";
                case "rejected":
                    return "bg-red-100 text-red-800";
                case "processed":
                    return "bg-blue-100 text-blue-800";
                default:
                    return "bg-gray-100 text-gray-800";
            }
        }

        /* ================= SCROLL TO REFUND ================= */
        function scrollToRefund() {

            const section = document.getElementById("refundSection");

            if (section.classList.contains("hidden")) {
                section.classList.remove("hidden");
                fetchRefunds();
            }

            section.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        }

        /* ================= DOWNLOAD INVOICE ================= */
        async function downloadInvoice(orderId) {
            try {
                const response = await fetch(`/api/orders/invoice/${orderId}`, {
                    method: "GET",
                    headers: {
                        "Authorization": `Bearer ${localStorage.getItem("token")}`,
                        "Accept": "application/pdf"
                    }
                });

                if (!response.ok) {
                    throw new Error("Failed to download invoice");
                }

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);

                const a = document.createElement("a");
                a.href = url;
                a.download = `invoice-${orderId}.pdf`;
                document.body.appendChild(a);
                a.click();

                a.remove();
                window.URL.revokeObjectURL(url);

            } catch (error) {
                alert("Invoice download failed");
                console.error(error);
            }
        }
    </script>
</body>

</html>