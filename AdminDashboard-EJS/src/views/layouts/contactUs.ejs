<div class="min-h-screen bg-white p-6">
    <!-- HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-10 gap-3">
        <div>
            <h1 class="text-3xl font-bold text-black-900 tracking-tight flex items-center gap-4 mb-2 drop-shadow-md">
                <i class="fas fa-envelope text-black-400 animate-pulse"></i>
                <span>Contact Management</span>
            </h1>
            <span class="text-md text-gray-600 font-semibold">
                Manage contact messages, user inquiries & responses
            </span>
        </div>
    </div>

    <!-- STATS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 mb-10">
        <div
            class="bg-blue-500 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-blue-100 font-bold">Total Messages</p>
                    <span id="totalMessages"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-envelope text-5xl text-blue-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>
        <div
            class="bg-red-500 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-red-100 font-bold">Unread</p>
                    <span id="unreadMessages"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-envelope-open text-5xl text-red-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>
        <div
            class="bg-green-500 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-green-100 font-bold">Read</p>
                    <span id="readMessages"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-check-circle text-5xl text-green-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>
        <div
            class="bg-yellow-500 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-yellow-100 font-bold">New Today</p>
                    <span id="todayMessages"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-plus text-5xl text-yellow-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-3 mb-6 w-full">
        <div class="flex gap-2 w-full sm:w-auto">
            <input id="searchInput" type="text" placeholder="Search name, email, subject..."
                class="border border-gray-300 rounded px-2 py-2 w-full sm:w-56 text-xs bg-white focus:outline-none focus:ring-1 focus:ring-blue-400" />
            <select id="filterSelect" class="border px-2 py-2 text-xs rounded focus:outline-none focus:ring-1 focus:ring-blue-400">
                <option value="all">All</option>
                <option value="unread">Unread</option>
                <option value="read">Read</option>
                <option value="today">Today</option>
            </select>
            <select id="sortSelect" class="border px-2 py-2 text-xs rounded focus:outline-none focus:ring-1 focus:ring-blue-400">
                <option value="newest">Newest First</option>
                <option value="oldest">Oldest First</option>
            </select>
            <button onclick="applyFilters()"
                class="flex items-center gap-1 px-3 py-2 text-xs font-medium text-white bg-blue-600 rounded hover:bg-blue-700 transition duration-300">
                <i class="fas fa-search text-[10px]"></i> Search
            </button>
        </div>
    </div>

    <!-- SIMPLE VIEW MODAL -->
    <div id="viewModal"
        class="fixed inset-0 hidden z-50 bg-black/30 backdrop-blur-sm flex items-center justify-center p-4">

        <div class="bg-white w-full max-w-xl rounded-2xl shadow-2xl border overflow-hidden animate-fadeIn">

            <!-- Header -->
            <div class="flex justify-between items-center px-5 py-3 border-b bg-gradient-to-r from-blue-50 to-indigo-50">
        
                <h2 class="text-lg font-semibold flex items-center gap-2 text-gray-800">
                    <i class="fas fa-envelope-open-text text-blue-500"></i>
                    Message Details
                </h2>
        
                <button onclick="closeModal()"
                    class="w-7 h-7 flex items-center justify-center rounded-lg text-gray-500 hover:bg-red-100 hover:text-red-600 transition">
                    <i class="fas fa-times"></i>
                </button>
        
            </div>
        
            <!-- Body -->
            <div id="modalContent" class="p-4 space-y-4 text-sm text-gray-700 bg-gray-50">
            </div>
        
        </div>
    </div>

    <!-- LOAD MORE -->
    <div class="mt-4 text-center">
        <button id="loadMoreBtn" onclick="fetchMessages()"
            class="inline-flex items-center justify-center gap-1 bg-gray-400 text-white px-3 py-2 rounded-md text-xs font-medium hover:bg-gray-500 transition hidden w-full sm:w-auto mb-4">
            <i class="fas fa-arrow-down text-[10px]"></i> Load More
        </button>
    </div>

    <!-- TABLE -->
    <div class="bg-white rounded-xl shadow-lg border border-black-100 overflow-x-auto">
        <table class="w-full min-w-[700px] border border-gray-200 text-sm table-fixed">
            <thead class="bg-gradient-to-r from-black-50 via-black-100 to-white">
                <tr class="uppercase">
                    <th class="px-4 py-2 text-xs font-bold w-[60px] text-center">#</th>
                    <th class="px-4 py-2 text-xs font-bold text-center">Name</th>
                    <th class="px-4 py-2 text-xs font-bold text-center">Email</th>
                    <th class="px-4 py-2 text-xs font-bold text-center">Subject</th>
                    <th class="px-4 py-2 text-xs font-bold text-center">Status</th>
                    <th class="px-4 py-2 text-xs font-bold text-center">Date</th>
                    <th class="px-4 py-2 text-xs font-bold w-[160px] text-center">Action</th>
                </tr>
            </thead>
            <tbody id="contactTable" class="divide-y font-mono">
                <tr>
                    <td colspan="7" class="text-center py-8 text-gray-500">
                        <i class="fas fa-inbox text-3xl mb-2 opacity-50"></i>
                        <p>Loading messages...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- TOAST -->
    <div id="toast" class="fixed top-3 right-2 md:right-6 px-4 py-2 rounded shadow hidden z-50 text-white text-sm">
    </div>
</div>

<script>
    let allMessages = [];
    let filteredMessages = [];
    let sortValue = "newest";
    let page = 1;
    let hasMore = true;
    let isLoading = false;
    let cursor = null;
    let searchQuery = "";
    let filterValue = "all";
    const limit = 20;

    /* ------------------- DOM LOADED ------------------- */
    document.addEventListener("DOMContentLoaded", () => {
        fetchMessages(true);
        setupEventListeners();
    });

    /* ------------------- SETUP EVENT LISTENERS ------------------- */
    function setupEventListeners() {
        document.addEventListener("click", function (e) {
            if (e.target.closest(".mark-read")) {
                const id = e.target.closest(".mark-read").dataset.id;
                markAsRead(id);
            }
            if (e.target.closest(".delete-msg")) {
                const id = e.target.closest(".delete-msg").dataset.id;
                deleteMessage(id);
            }
            if (e.target.closest(".view-msg")) {
                const id = e.target.closest(".view-msg").dataset.id;
                openModal(id);
            }
        });

        document.getElementById('filterSelect').addEventListener('change', applyFilters);
        document.getElementById('sortSelect').addEventListener('change', applyFilters);
        document.getElementById('viewModal').addEventListener('click', function (e) {
            if (e.target === this) closeModal();
        });
        document.getElementById('searchInput').addEventListener('input', applyFilters);
    }

    /* ------------------- FETCH MESSAGES ------------------- */
    async function fetchMessages(reset = false) {
        if (isLoading) return;
        isLoading = true;

        if (reset) {
            cursor = null;
            allMessages = [];
            page = 1;
            document.getElementById("contactTable").innerHTML = "";
            document.getElementById("loadMoreBtn").classList.add("hidden");
        }

        try {
            let url = `/api/contact-us/view?limit=${limit}&search=${encodeURIComponent(searchQuery)}&filter=${filterValue}&sort=${sortValue}`;
            if (cursor) {
                url += `&cursor=${encodeURIComponent(cursor)}`;
            }

            const res = await fetch(url, { headers: { Accept: "application/json" } });
            const data = await res.json();
            if (!data.success) throw new Error();

            const newMessages = data.data || [];
            allMessages = [...allMessages, ...newMessages];
            cursor = data.pageInfo?.nextCursor || null;

            document.getElementById("loadMoreBtn").classList.toggle("hidden", !data.pageInfo?.hasNextPage);
            renderTable();
            updateStats();

        } catch (err) {
            showTempMessage("Error loading messages", "error");
        } finally {
            isLoading = false;
        }
    }

    /* ------------------- RENDER TABLE ------------------- */
    function renderTable() {
        const tbody = document.getElementById("contactTable");
        const messagesToShow = filteredMessages.length > 0 ? filteredMessages : allMessages;

        if (messagesToShow.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-6 bg-white text-gray-500 font-semibold">Messages not found</td></tr>`;
            return;
        }

        tbody.innerHTML = "";
        messagesToShow.forEach((msg, index) => {
            const tr = document.createElement("tr");
            tr.setAttribute("data-id", msg._id);

            tr.innerHTML = `
<td class="px-4 py-3 text-xs font-semibold text-gray-500 text-center w-[60px]">
${(page - 1) * limit + index + 1}.
</td>

<td class="px-4 py-3 font-semibold text-gray-800 text-sm text-center truncate max-w-[140px]">
${escapeHtml(msg.name)}
</td>

<td class="px-4 py-3 text-gray-700 text-xs text-center truncate max-w-[180px]">
${escapeHtml(msg.email)}
</td>

<td class="px-4 py-3 text-xs text-center truncate max-w-[200px]" title="${escapeHtml(msg.subject)}">
${escapeHtml(msg.subject || "No subject")}
</td>

<td class="px-4 py-3 text-center">
<span class="px-3 py-1 text-xs font-semibold rounded-full ${msg.isRead
                    ? "bg-green-100 text-green-700"
                    : "bg-red-100 text-red-700"
                }">
${msg.isRead ? "Read" : "Unread"}
</span>
</td>

<td class="px-4 py-3 text-center">
<div class="text-black-900 text-xs font-medium">
${msg.createdAt ? new Date(msg.createdAt).toLocaleDateString() : "-"}
</div>
<div class="text-gray-400 text-xs">
${msg.createdAt ? new Date(msg.createdAt).toLocaleTimeString() : ""}
</div>
</td>

<td class="px-4 py-3 text-center w-[140px]">
  <div class="flex justify-center gap-2">

    ${!msg.isRead
                    ? `
    <button
      class="mark-read w-7 h-7 flex items-center justify-center rounded-md bg-indigo-100 text-indigo-600 hover:bg-indigo-200 transition"
      data-id="${msg._id}"
      title="Mark as Read">
      <i class="fas fa-check text-xs"></i>
    </button>
    `
                    : ""
                }

    <button
      class="view-msg w-7 h-7 flex items-center justify-center rounded-md bg-blue-100 text-blue-600 hover:bg-blue-200 transition"
      data-id="${msg._id}"
      title="View">
      <i class="fas fa-eye text-xs"></i>
    </button>

    <button
      class="delete-msg w-7 h-7 flex items-center justify-center rounded-md bg-red-100 text-red-600 hover:bg-red-200 transition"
      data-id="${msg._id}"
      title="Delete">
      <i class="fas fa-trash text-xs"></i>
    </button>

  </div>
</td>
`;
            tbody.appendChild(tr);
        });
    }

    /* ------------------- MARK AS READ ------------------- */
    async function markAsRead(id) {
        try {
            const res = await fetch(`/api/contact-us/read/${id}`, { method: "PATCH" });
            const data = await res.json();
            if (!data.success) throw new Error();

            const msgIndex = allMessages.findIndex(m => m._id === id);
            if (msgIndex !== -1) {
                allMessages[msgIndex].isRead = true;
            }
            renderTable();
            updateStats();
            showTempMessage("Message marked as read", "success");
        } catch (err) {
            showTempMessage("Failed to mark as read", "error");
        }
    }

    /* ------------------- DELETE MESSAGE ------------------- */
    async function deleteMessage(id) {
        if (!confirm("Are you sure you want to delete this message?")) return;
        try {
            const res = await fetch(`/api/contact-us/delete/${id}`, { method: "DELETE" });
            const data = await res.json();
            if (!data.success) throw new Error();

            allMessages = allMessages.filter(msg => msg._id !== id);
            renderTable();
            updateStats();
            showTempMessage("Message deleted successfully", "success");
        } catch (err) {
            showTempMessage("Failed to delete message", "error");
        }
    }

    /* ------------------- OPEN MODAL ------------------- */
    function openModal(id) {

        const msg = allMessages.find(m => m._id === id);
        if (!msg) return;

        const statusBadge = msg.isRead
            ? `<span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700 font-semibold">Read</span>`
            : `<span class="px-2 py-1 text-xs rounded-full bg-red-100 text-red-700 font-semibold">Unread</span>`;

        document.getElementById('modalContent').innerHTML = `

<div class="grid grid-cols-2 gap-4">

    <div class="bg-white p-4 rounded-xl border shadow-sm">
        <p class="text-xs text-gray-500 flex items-center gap-1">
            <i class="fas fa-user text-blue-400"></i> Name
        </p>
        <p class="font-semibold text-gray-800 mt-1">
            ${escapeHtml(msg.name || 'N/A')}
        </p>
    </div>

    <div class="bg-white p-4 rounded-xl border shadow-sm">
        <p class="text-xs text-gray-500 flex items-center gap-1">
            <i class="fas fa-envelope text-blue-400"></i> Email
        </p>
        <p class="font-semibold text-gray-800 mt-1 break-all">
            ${escapeHtml(msg.email || 'N/A')}
        </p>
    </div>

    <div class="col-span-2 bg-white p-4 rounded-xl border shadow-sm">
        <p class="text-xs text-gray-500 flex items-center gap-1">
            <i class="fas fa-tag text-blue-400"></i> Subject
        </p>
        <p class="font-semibold text-gray-800 mt-1">
            ${escapeHtml(msg.subject || 'No subject')}
        </p>
    </div>

</div>


<div class="bg-white p-5 rounded-xl border shadow-sm">

    <p class="text-xs text-gray-500 mb-2 flex items-center gap-1">
        <i class="fas fa-comment-dots text-blue-400"></i> Message
    </p>

    <div class="p-4 bg-gray-50 border rounded-lg text-sm whitespace-pre-wrap leading-relaxed">
        ${escapeHtml(msg.message || 'No message content')}
    </div>

</div>


<div class="flex justify-between items-center text-xs text-gray-500 pt-2 border-t">

    <div class="flex items-center gap-2">
        <span>Status:</span>
        ${statusBadge}
    </div>

    <div class="text-gray-400">
        ID:
        <span class="font-mono text-gray-600">${msg._id}</span>
    </div>

</div>
`;
        document.getElementById('viewModal').classList.remove('hidden');
    }

    /* ------------------- CLOSE MODAL ------------------- */
    function closeModal() {
        document.getElementById('viewModal').classList.add('hidden');
    }

    /* ------------------- EVENT LISTENER FOR MODAL ------------------- */
    document.getElementById('viewModal').addEventListener('click', function (e) {
        if (e.target === this) closeModal();
    });

    /* ------------------- APPLY FILTERS ------------------- */
    function applyFilters() {
        if (window.filterTimeout) clearTimeout(window.filterTimeout);
        window.filterTimeout = setTimeout(() => {
            searchQuery = document.getElementById("searchInput").value.trim();
            filterValue = document.getElementById("filterSelect").value;
            sortValue = document.getElementById("sortSelect").value;
            page = 1;
            fetchMessages(true);
        }, 300);
    }

    /* ------------------- UPDATE STATS ------------------- */
    function updateStats() {
        const messages = filteredMessages.length > 0 ? filteredMessages : allMessages;
        const total = messages.length;
        const unread = messages.filter(m => !m.isRead).length;
        const read = total - unread;
        const today = messages.filter(m => new Date(m.createdAt).toDateString() === new Date().toDateString()).length;

        document.getElementById("totalMessages").textContent = total;
        document.getElementById("unreadMessages").textContent = unread;
        document.getElementById("readMessages").textContent = read;
        document.getElementById("todayMessages").textContent = today;
    }

    /* ------------------- ESCAPE HTML ------------------- */
    function escapeHtml(text) {
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text?.replace(/[&<>"']/g, m => map[m]) || '';
    }

    /* ------------------- SHOW TEMP MESSAGE ------------------- */
    function showTempMessage(message, type = "success") {
        const toast = document.getElementById("toast");
        toast.textContent = message;
        toast.className = `fixed top-3 right-6 px-4 py-2 rounded shadow text-sm z-50 text-white ${type === "success" ? "bg-green-600" : "bg-red-600"}`;
        toast.classList.remove("hidden");
        setTimeout(() => toast.classList.add("hidden"), 3000);
    }
</script>