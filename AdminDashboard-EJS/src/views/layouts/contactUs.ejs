<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-slate-100 p-6">
    <!-- HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-10 gap-3">
        <div>
            <h1
                class="text-4xl font-extrabold text-blue-900 tracking-tight flex items-center gap-4 mb-2 drop-shadow-md">
                <i class="fas fa-envelope text-blue-400 animate-pulse"></i>
                <span>Contact Management</span>
            </h1>
            <span class="text-base text-gray-600 font-semibold">
                Manage contact messages, user inquiries & responses
            </span>
        </div>
    </div>

    <!-- STATS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 mb-10">
        <div
            class="bg-gradient-to-br from-blue-400 via-blue-500 to-blue-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-blue-100 font-bold">Total Messages</p>
                    <span id="totalMessages"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-envelope text-5xl text-blue-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>
        <div
            class="bg-gradient-to-br from-red-400 via-red-500 to-red-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-red-100 font-bold">Unread</p>
                    <span id="unreadMessages"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-envelope-open text-5xl text-red-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>
        <div
            class="bg-gradient-to-br from-green-400 via-green-500 to-green-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-green-100 font-bold">Read</p>
                    <span id="readMessages"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-check-circle text-5xl text-green-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>
        <div
            class="bg-gradient-to-br from-indigo-400 via-indigo-500 to-indigo-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-indigo-100 font-bold">New Today</p>
                    <span id="todayMessages"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-plus text-5xl text-indigo-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-3 mb-6 w-full">
        <div class="flex gap-2 w-full sm:w-auto">
            <input id="searchInput" type="text" placeholder="Search name, email, subject..."
                class="border border-gray-300 rounded px-2 py-2 w-full sm:w-56 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-400" />
            <select id="filterSelect" class="border px-2 py-2 text-xs rounded">
                <option value="all">All</option>
                <option value="unread">Unread</option>
                <option value="read">Read</option>
                <option value="today">Today</option>
            </select>
            <select id="sortSelect" class="border px-2 py-2 text-xs rounded">
                <option value="newest">Newest First</option>
                <option value="oldest">Oldest First</option>
            </select>
            <button onclick="applyFilters()"
                class="flex items-center gap-1 px-3 py-2 text-xs font-medium text-white bg-blue-600 rounded hover:bg-blue-700 transition duration-300">
                <i class="fas fa-search text-[10px]"></i> Search
            </button>
        </div>
    </div>

    <!-- SIMPLE VIEW MODAL -->
    <div id="viewModal" class="fixed inset-0 hidden z-50 bg-black/50 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-lg shadow-xl border overflow-hidden">
            <!-- Header -->
            <div class="flex justify-between items-center bg-blue-400 text-white px-4 py-3">
                <h2 class="text-lg font-semibold flex items-center gap-2 text-black">
                    <i class="fas fa-envelope-open-text"></i> View Message
                </h2>
                <button onclick="closeModal()" class="text-white text-xl hover:text-gray-200">&times;</button>
            </div>

            <!-- Body -->
            <div id="modalContent" class="p-4 text-gray-700 text-sm max-h-[70vh] overflow-y-auto space-y-3">
            </div>
        </div>
    </div>
    
    <!-- LOAD MORE -->
    <div class="mt-4 text-center">
        <button id="loadMoreBtn" onclick="fetchMessages()"
            class="inline-flex items-center justify-center gap-1 bg-gray-400 text-white px-3 py-2 rounded-md text-xs font-medium hover:bg-gray-500 transition hidden w-full sm:w-auto mb-4">
            <i class="fas fa-arrow-down text-[10px]"></i> Load More
        </button>
    </div>

    <!-- TABLE -->
    <div class="bg-white rounded-xl shadow-lg border border-blue-100 overflow-x-auto">
        <table class="w-full min-w-[700px] border border-gray-200 text-sm table-fixed">
            <thead class="bg-gradient-to-r from-blue-50 via-blue-100 to-white">
                <tr>
                    <th class="px-4 py-2 text-xs font-bold text-blue-700 w-[60px] text-center">#</th>
                    <th class="px-4 py-2 text-xs font-bold text-blue-700 text-center">Name</th>
                    <th class="px-4 py-2 text-xs font-bold text-blue-700 text-center">Email</th>
                    <th class="px-4 py-2 text-xs font-bold text-blue-700 text-center">Subject</th>
                    <th class="px-4 py-2 text-xs font-bold text-blue-700 text-center">Status</th>
                    <th class="px-4 py-2 text-xs font-bold text-blue-700 text-center">Date</th>
                    <th class="px-4 py-2 text-xs font-bold text-blue-700 w-[160px] text-center">Action</th>
                </tr>
            </thead>
            <tbody id="contactTable" class="divide-y font-mono">
                <tr>
                    <td colspan="7" class="text-center py-8 text-gray-500">
                        <i class="fas fa-inbox text-3xl mb-2 opacity-50"></i>
                        <p>Loading messages...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- TOAST -->
    <div id="toast" class="fixed top-6 right-2 md:right-6 px-4 py-2 rounded shadow hidden z-50 text-white text-sm">
    </div>
</div>

<script>
    let allMessages = [];
    let filteredMessages = [];
    let sortValue = "newest";
    let page = 1;
    let hasMore = true;
    let isLoading = false;
    let cursor = null;
    let searchQuery = "";
    let filterValue = "all";
    const limit = 20;

    /* ------------------- DOM LOADED ------------------- */
    document.addEventListener("DOMContentLoaded", () => {
        fetchMessages(true);
        setupEventListeners();
    });

    /* ------------------- SETUP EVENT LISTENERS ------------------- */
    function setupEventListeners() {
        document.addEventListener("click", function (e) {
            if (e.target.closest(".mark-read")) {
                const id = e.target.closest(".mark-read").dataset.id;
                markAsRead(id);
            }
            if (e.target.closest(".delete-msg")) {
                const id = e.target.closest(".delete-msg").dataset.id;
                deleteMessage(id);
            }
            if (e.target.closest(".view-msg")) {
                const id = e.target.closest(".view-msg").dataset.id;
                openModal(id);
            }
        });

        document.getElementById('filterSelect').addEventListener('change', applyFilters);
        document.getElementById('sortSelect').addEventListener('change', applyFilters);
        document.getElementById('viewModal').addEventListener('click', function (e) {
            if (e.target === this) closeModal();
        });
        document.getElementById('searchInput').addEventListener('input', applyFilters);
    }

    /* ------------------- FETCH MESSAGES ------------------- */
    async function fetchMessages(reset = false) {
        if (isLoading) return;
        isLoading = true;

        if (reset) {
            cursor = null;
            allMessages = [];
            page = 1;
            document.getElementById("contactTable").innerHTML = "";
            document.getElementById("loadMoreBtn").classList.add("hidden");
        }

        try {
            let url = `/api/contact-us/view?limit=${limit}&search=${encodeURIComponent(searchQuery)}&filter=${filterValue}&sort=${sortValue}`;
            if (cursor) {
                url += `&cursor=${encodeURIComponent(cursor)}`;
            }

            const res = await fetch(url, { headers: { Accept: "application/json" } });
            const data = await res.json();
            if (!data.success) throw new Error();

            const newMessages = data.data || [];
            allMessages = [...allMessages, ...newMessages];
            cursor = data.pageInfo?.nextCursor || null;

            document.getElementById("loadMoreBtn").classList.toggle("hidden", !data.pageInfo?.hasNextPage);
            renderTable();
            updateStats();

        } catch (err) {
            showTempMessage("Error loading messages", "error");
        } finally {
            isLoading = false;
        }
    }

    /* ------------------- RENDER TABLE ------------------- */
    function renderTable() {
        const tbody = document.getElementById("contactTable");
        const messagesToShow = filteredMessages.length > 0 ? filteredMessages : allMessages;

        if (messagesToShow.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-6 bg-white text-gray-500 font-semibold">Messages not found</td></tr>`;
            return;
        }

        tbody.innerHTML = "";
        messagesToShow.forEach((msg, index) => {
            const tr = document.createElement("tr");
            tr.setAttribute("data-id", msg._id);

            tr.innerHTML = `
        <td class="px-4 py-3 font-mono text-xs text-blue-900 w-[50px] text-center">
            ${(page - 1) * limit + index + 1}.
        </td>

        <td class="px-4 py-3 font-mono text-sm font-bold text-blue-700 text-center min-w-[120px] break-words">
            ${escapeHtml(msg.name)}
        </td>

        <td class="px-4 py-3 font-mono text-[12px] text-blue-800 text-center min-w-[150px] break-words">
            ${escapeHtml(msg.email)}
        </td>

        <td class="px-4 py-3 font-mono text-[12px] text-center max-w-[200px] truncate" title="${escapeHtml(msg.subject)}">
            ${escapeHtml(msg.subject || "No subject")}
        </td>

        <td class="px-4 py-3 text-center">
            <span class="px-2 py-1 text-xs rounded font-bold tracking-wider ${msg.isRead ? "bg-green-600 text-white" : "bg-red-600 text-white"}">
                ${msg.isRead ? "Read" : "Unread"}
            </span>
        </td>

        <td class="px-4 py-3 font-mono text-xs text-center min-w-[120px]">
            <div>${msg.createdAt ? new Date(msg.createdAt).toLocaleDateString() : "-"}</div>
            <div class="text-gray-500 text-[10px]">${msg.createdAt ? new Date(msg.createdAt).toLocaleTimeString() : ""}</div>
        </td>

        <td class="px-4 py-3 w-[160px] text-center">
            <div class="flex gap-1 justify-center">
                ${!msg.isRead ? `
                    <button class="mark-read px-2 py-1 text-xs bg-indigo-100 text-indigo-700 rounded hover:bg-indigo-300 transition" data-id="${msg._id}" title="Mark as Read">
                        <i class="fas fa-check"></i>
                    </button>
                ` : ""}
                <button class="view-msg px-2 py-1 text-xs bg-blue-100 text-blue-700 rounded hover:bg-blue-300 transition" data-id="${msg._id}" title="View">
                    <i class="fas fa-eye"></i>
                </button>
                <button class="delete-msg px-2 py-1 text-xs bg-red-100 text-red-700 rounded hover:bg-red-300 transition" data-id="${msg._id}" title="Delete">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </td>
    `;
            tbody.appendChild(tr);
        });
    }

    /* ------------------- MARK AS READ ------------------- */
    async function markAsRead(id) {
        try {
            const res = await fetch(`/api/contact-us/read/${id}`, { method: "PATCH" });
            const data = await res.json();
            if (!data.success) throw new Error();

            const msgIndex = allMessages.findIndex(m => m._id === id);
            if (msgIndex !== -1) {
                allMessages[msgIndex].isRead = true;
            }
            renderTable();
            updateStats();
            showTempMessage("Message marked as read", "success");
        } catch (err) {
            showTempMessage("Failed to mark as read", "error");
        }
    }

    /* ------------------- DELETE MESSAGE ------------------- */
    async function deleteMessage(id) {
        if (!confirm("Are you sure you want to delete this message?")) return;
        try {
            const res = await fetch(`/api/contact-us/delete/${id}`, { method: "DELETE" });
            const data = await res.json();
            if (!data.success) throw new Error();

            allMessages = allMessages.filter(msg => msg._id !== id);
            renderTable();
            updateStats();
            showTempMessage("Message deleted successfully", "success");
        } catch (err) {
            showTempMessage("Failed to delete message", "error");
        }
    }

    /* ------------------- OPEN MODAL ------------------- */
    function openModal(id) {
        const msg = allMessages.find(m => m._id === id);
        if (!msg) return;

        document.getElementById('modalContent').innerHTML = `
        <p class="mb-1"><strong>Name:</strong> ${escapeHtml(msg.name || 'N/A')}</p>
        <p class="mb-1"><strong>Email:</strong> ${escapeHtml(msg.email || 'N/A')}</p>
        <p class="mb-1"><strong>Subject:</strong> ${escapeHtml(msg.subject || 'No subject')}</p>

        <div class="mt-2 p-3 bg-gray-50 border rounded-md font-mono text-sm whitespace-pre-wrap">
            ${escapeHtml(msg.message || 'No message content')}
        </div>

        <div class="mt-2 flex justify-between items-center text-xs text-gray-500">
            <p><strong>Status:</strong> 
                <span class="${msg.isRead ? 'text-green-700 font-semibold' : 'text-red-700 font-semibold'}">
                    ${msg.isRead ? 'Read' : 'Unread'}
                </span>
            </p>
            <p><strong>ID:</strong> ${msg._id}</p>
        </div>
    `;

        document.getElementById('viewModal').classList.remove('hidden');
    }

    /* ------------------- CLOSE MODAL ------------------- */
    function closeModal() {
        document.getElementById('viewModal').classList.add('hidden');
    }

    /* ------------------- EVENT LISTENER FOR MODAL ------------------- */
    document.getElementById('viewModal').addEventListener('click', function (e) {
        if (e.target === this) closeModal();
    });

    /* ------------------- APPLY FILTERS ------------------- */
    function applyFilters() {
        if (window.filterTimeout) clearTimeout(window.filterTimeout);
        window.filterTimeout = setTimeout(() => {
            searchQuery = document.getElementById("searchInput").value.trim();
            filterValue = document.getElementById("filterSelect").value;
            sortValue = document.getElementById("sortSelect").value;
            page = 1;
            fetchMessages(true);
        }, 300);
    }

    /* ------------------- UPDATE STATS ------------------- */
    function updateStats() {
        const messages = filteredMessages.length > 0 ? filteredMessages : allMessages;
        const total = messages.length;
        const unread = messages.filter(m => !m.isRead).length;
        const read = total - unread;
        const today = messages.filter(m => new Date(m.createdAt).toDateString() === new Date().toDateString()).length;

        document.getElementById("totalMessages").textContent = total;
        document.getElementById("unreadMessages").textContent = unread;
        document.getElementById("readMessages").textContent = read;
        document.getElementById("todayMessages").textContent = today;
    }

    /* ------------------- ESCAPE HTML ------------------- */
    function escapeHtml(text) {
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text?.replace(/[&<>"']/g, m => map[m]) || '';
    }

    /* ------------------- SHOW TEMP MESSAGE ------------------- */
    function showTempMessage(message, type = "success") {
        const toast = document.getElementById("toast");
        toast.textContent = message;
        toast.className = `fixed top-3 right-6 px-4 py-2 rounded shadow text-sm z-50 text-white ${type === "success" ? "bg-green-600" : "bg-red-600"}`;
        toast.classList.remove("hidden");
        setTimeout(() => toast.classList.add("hidden"), 3000);
    }
</script>