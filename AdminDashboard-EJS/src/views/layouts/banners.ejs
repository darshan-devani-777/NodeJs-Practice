<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-slate-100 p-6">

    <!-- HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-10 gap-3">
        <div>
            <h1
                class="text-4xl font-extrabold text-blue-900 tracking-tight flex items-center gap-4 mb-2 drop-shadow-md">
                <i class="fas fa-images text-blue-400 animate-pulse"></i>
                <span>Banner Management</span>
            </h1>

            <span class="text-base text-gray-600 font-semibold">
                Manage homepage banners & links
            </span>
        </div>
    </div>

    <!-- STATS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mb-10">

        <!-- Total Banners -->
        <div
            class="bg-gradient-to-br from-blue-400 via-blue-500 to-blue-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-blue-100 font-bold">Total Banners</p>
                    <span id="totalBanners"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-images text-5xl text-blue-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>

        <!-- Active Banners -->
        <div
            class="bg-gradient-to-br from-green-400 via-green-500 to-green-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-green-100 font-bold">Active Banners</p>
                    <span id="activeBanners"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-check-circle text-5xl text-green-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>

        <!-- Inactive Banners -->
        <div
            class="bg-gradient-to-br from-slate-400 via-slate-500 to-slate-700 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-100 font-bold">Inactive Banners</p>
                    <span id="inactiveBanners"
                        class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
                </div>
                <i class="fas fa-ban text-5xl text-slate-200 opacity-80 group-hover:scale-125 transition"></i>
            </div>
        </div>

    </div>

    <!-- SEARCH + CREATE -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-3 mb-6 w-full">

        <!-- Left: Search -->
        <div class="flex gap-2 w-full sm:w-auto">
            <input id="searchInput" placeholder="Search banner title..."
                class="border border-gray-300 rounded px-2 py-2 w-full sm:w-56 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-400" />

            <button onclick="onSearchBanner()"
                class="flex items-center gap-1 px-3 py-2 text-xs font-medium text-white bg-blue-600 rounded hover:bg-blue-700">
                <i class="fas fa-search text-[10px]"></i>
                Search
            </button>
        </div>

        <!-- Right: Create Banner Button -->
        <div class="w-full sm:w-auto flex justify-start sm:justify-end">
            <button onclick="openCreateModal()"
                class="flex items-center gap-1 px-4 py-2 text-xs font-medium text-white bg-green-600 rounded hover:bg-green-700 transition duration-300">

                <i class="fas fa-plus text-[10px]"></i>
                Banner

            </button>
        </div>

    </div>

    <!-- TABLE -->
    <div class="bg-white rounded-xl shadow-lg border border-blue-100 overflow-x-auto">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[700px] border border-gray-200 text-sm table-fixed">

                <thead class="bg-gradient-to-r from-blue-50 via-blue-100 to-white">
                    <tr>
                        <th class="px-4 py-2 text-xs font-bold text-blue-700 w-[60px] text-center">#</th>
                        <th class="px-4 py-2 text-xs font-bold text-blue-700 w-[120px] text-center">Image</th>
                        <th class="px-4 py-2 text-xs font-bold text-blue-700 text-center">Title</th>
                        <th class="px-4 py-2 text-xs font-bold text-blue-700 text-center">Link</th>
                        <th class="px-4 py-2 text-xs font-bold text-blue-700 w-[100px] text-center">Status</th>
                        <th class="px-4 py-2 text-xs font-bold text-blue-700 w-[150px] text-center">Created</th>
                        <th class="px-4 py-2 text-xs font-bold text-blue-700 w-[140px] text-center">Action</th>
                    </tr>
                </thead>

                <tbody id="bannerTable" class="divide-y font-mono">
                    <!-- rows via JS -->
                </tbody>

            </table>
        </div>
    </div>

    <!-- MODAL -->
    <div id="bannerModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <div class="bg-white w-full max-w-xl rounded-xl shadow-2xl p-6 relative animate-fade-in">

            <!-- Header -->
            <div class="flex justify-between items-center mb-4">
                <h2 id="modalTitle" class="text-lg font-bold text-blue-800">
                    Create Banner
                </h2>

                <button onclick="closeBannerModal()" class="text-gray-500 hover:text-red-500">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>

            <!-- FORM -->
            <form id="bannerForm" onsubmit="saveBanner(event)" class="space-y-4">
                <input type="hidden" id="bannerId">

                <!-- TITLE -->
                <div>
                    <label class="text-xs font-bold text-gray-600">Banner Title *</label>
                    <input id="bannerTitle" type="text"
                        class="w-full border-2 rounded px-3 py-2 text-sm focus:ring-1 focus:ring-blue-400 transition-all duration-200"
                        style="border-color: #d1d5db;">
                    <p id="bannerTitleError" class="text-xs text-red-500 mt-1 hidden"></p>
                </div>

                <!-- DESCRIPTION -->
                <div>
                    <label class="text-xs font-bold text-gray-600">Description *</label>
                    <textarea id="bannerDescription" rows="4"
                        class="w-full border-2 rounded px-3 py-2 text-sm focus:ring-0 focus:ring-blue-400 transition-all duration-200"
                        style="border-color: #d1d5db;"></textarea>
                    <p id="bannerDescriptionError" class="text-xs text-red-500 mt-1 hidden"></p>
                </div>

                <!-- LINK -->
                <div>
                    <label class="text-xs font-bold text-gray-600">Banner Link</label>
                    <input id="bannerLink" type="url"
                        class="w-full border-2 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 transition-all duration-200"
                        style="border-color: #d1d5db;" placeholder="https://example.com">
                    <p id="bannerLinkError" class="text-xs text-red-500 mt-1 hidden"></p>
                </div>

                <!-- IMAGE -->
                <div>
                    <label class="text-xs font-bold text-gray-600">Banner Image *</label>
                    <input id="bannerImage" type="file" accept="image/*"
                        class="w-full border-2 rounded px-3 py-2 text-sm bg-white transition-all duration-200"
                        style="border-color: #d1d5db;">
                    <p id="bannerImageError" class="text-xs text-red-500 mt-1 hidden"></p>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="flex justify-end gap-2 pt-2">
                    <button type="submit" id="saveBannerBtn"
                        class="px-4 py-2 text-xs rounded bg-blue-600 text-white hover:bg-blue-700 transition duration-300 flex items-center justify-center gap-2">
                        <svg id="bannerSpinner" class="hidden animate-spin h-4 w-4 text-white"
                            xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                            </circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                        </svg>
                        <span id="saveBannerBtnText">Save Banner</span>
                    </button>
                    <button type="button" onclick="closeBannerModal()"
                        class="px-4 py-2 text-xs rounded bg-gray-400 text-white hover:bg-gray-500 transition duration-300">
                        Cancel
                    </button>
                </div>
            </form>

        </div>

    </div>

    <div class="mt-4 text-center">
        <button id="loadMoreBannersBtn"
            class="inline-flex items-center justify-center gap-1 bg-gray-400 text-white px-3 py-2 rounded-md text-xs font-medium hover:bg-gray-500 transition hidden w-full sm:w-auto mb-4"
            onclick="fetchBanners()">
            <i class="fas fa-arrow-down text-[10px]"></i>
            Load More
        </button>
    </div>

    <!-- TOAST -->
    <div id="toast" class="fixed top-6 right-2 md:right-6 px-4 py-2 rounded shadow hidden z-50 text-white text-sm">
    </div>

</div>

<script>

    let banners = []
    let bannerCursor = null;
    const bannerLimit = 5;
    let editingBannerId = null

    /* ================= SAFE JSON ================= */
    async function safeParseJSON(res) {
        const text = await res.text()

        try {
            return JSON.parse(text)
        } catch {
            showToast("Session expired or server error. Please refresh!", "error")
            throw new Error("Invalid JSON")
        }
    }

    /* ================= ANIMATE NUMBER ================= */
    function animateNumber(id, start, end, duration = 800) {
        const el = document.getElementById(id);
        if (!el) return;

        let startTime = null;
        function step(timestamp) {
            if (!startTime) startTime = timestamp;
            const progress = Math.min((timestamp - startTime) / duration, 1);
            el.textContent = Math.floor(progress * (end - start) + start);
            if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
    }

    /* ================= ESCAPE HTML ================= */
    function escapeHTML(str) {
        if (typeof str !== "string") return ""
        return str.replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;")
    }

    /* ================= FETCH BANNERS ================= */
    async function fetchBanners(reset = false) {

        if (reset) {
            banners = [];
            bannerCursor = null;
        }

        let url = `/api/banners/all-banners?limit=${bannerLimit}`;
        if (bannerCursor) url += `&cursor=${encodeURIComponent(bannerCursor)}`;

        try {
            const res = await fetch(url, { headers: { Accept: "application/json" } });
            const data = await safeParseJSON(res);

            if (!data.success) throw new Error(data.message);

            banners = [...banners, ...data.data];
            renderBanners();
            updateBannerStats();

            bannerCursor = data.pageInfo.hasNextPage ? data.pageInfo.nextCursor : null;

            document.getElementById("loadMoreBannersBtn").classList.toggle("hidden", !bannerCursor);

        } catch (err) {
            showToast(err.message || "Failed to fetch banners", "error");
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        fetchBanners(true);
    });

    /* ================= STATS ================= */
    function updateBannerStats() {

        const total = banners.length;
        const active = banners.filter(b => b.isActive).length;
        const inactive = total - active;

        animateNumber("totalBanners", parseInt(document.getElementById("totalBanners").textContent) || 0, total, 600);
        animateNumber("activeBanners", parseInt(document.getElementById("activeBanners").textContent) || 0, active, 600);
        animateNumber("inactiveBanners", parseInt(document.getElementById("inactiveBanners").textContent) || 0, inactive, 600);

    }

    /* ================= RENDER TABLE ================= */
    function renderBanners() {

        const tbody = document.getElementById("bannerTable")

        tbody.innerHTML = ""

        if (!banners.length) {

            tbody.innerHTML = `
            <tr>
            <td colspan="7" class="text-center py-6 bg-white text-gray-500 font-semibold">
            Banners not found
            </td>
            </tr>
            `

            return
        }

        banners.forEach((b, i) => {

            const tr = document.createElement("tr")

            tr.setAttribute("data-id", b._id)

            tr.innerHTML = `
    
            <td class="px-4 py-3 text-xs text-center font-mono">${i + 1}</td>
    
            <td class="px-4 py-3 text-center">
            <img src="${b.image}" class="h-12 rounded mx-auto">
            </td>
    
            <td class="px-4 py-3 text-sm text-center font-bold text-blue-700 break-words">
            ${escapeHTML(b.title)}
            </td>
    
            <td class="px-4 py-3 text-center break-words">
            ${b.link ? `<a href="${escapeHTML(b.link)}" target="_blank" class="text-blue-600 underline break-words">Link</a>` : "-"}
            </td>
    
            <td class="px-4 py-3 text-center">
            <span class="px-2 py-1 text-xs rounded font-bold tracking-wider ${b.isActive ? "bg-green-600 text-white" : "bg-gray-400 text-white"
                }">
            ${b.isActive ? "Active" : "Inactive"}
            </span>
            </td>
    
           <td class="px-4 py-3 text-xs text-center max-w-[140px]">
           <div>
                ${b.createdAt ? new Date(b.createdAt).toLocaleDateString() : "-"}
           </div>
           <div class="text-gray-500 text-[10px]">
                ${b.createdAt ? new Date(b.createdAt).toLocaleTimeString() : ""}
           </div>
           </div>
           </td>
    
            <td class="px-4 py-3 text-center">
            <div class="flex gap-2 justify-center">
    
            <button onclick="toggleBannerStatus('${b._id}',${!b.isActive})"
            class="px-2 py-1 text-xs bg-indigo-100 text-indigo-700 rounded hover:bg-indigo-300">
            <i class="fas fa-toggle-${b.isActive ? "on" : "off"}"></i>
            </button>
    
            <button onclick="openEditBannerModal('${b._id}')"
            class="px-2 py-1 text-xs bg-yellow-100 text-yellow-700 rounded hover:bg-yellow-300">
            <i class="fas fa-edit"></i>
            </button>
    
            <button onclick="deleteBanner('${b._id}')"
            class="px-2 py-1 text-xs bg-red-100 text-red-700 rounded hover:bg-red-300">
            <i class="fas fa-trash"></i>
            </button>
    
            </div>
            </td>
            `

            tbody.appendChild(tr)

        })

    }

    /* ================= OPEN CREATE MODAL ================= */
    function openCreateModal() {

        editingBannerId = null

        document.getElementById("modalTitle").textContent = "Create Banner"

        document.getElementById("bannerForm").reset()

        const modal = document.getElementById("bannerModal")

        modal.classList.remove("hidden")
        modal.classList.add("flex")

    }

    /* ================= OPEN EDIT MODAL ================= */
    function openEditBannerModal(id) {

        const banner = banners.find(b => b._id === id)

        if (!banner) return

        editingBannerId = id

        document.getElementById("modalTitle").textContent = "Update Banner"

        document.getElementById("bannerTitle").value = banner.title
        document.getElementById("bannerDescription").value = banner.description || ""
        document.getElementById("bannerLink").value = banner.link || ""

        const modal = document.getElementById("bannerModal")

        modal.classList.remove("hidden")
        modal.classList.add("flex")

    }

    /* ================= CLOSE MODAL ================= */
    function closeBannerModal() {

        const modal = document.getElementById("bannerModal")

        modal.classList.add("hidden")
        modal.classList.remove("flex")

        editingBannerId = null

    }

    /* ================= SAVE ================= */
    async function saveBanner(e) {
        e.preventDefault();
        clearFormErrors();

        const title = document.getElementById("bannerTitle").value.trim();
        const description = document.getElementById("bannerDescription").value.trim();
        const link = document.getElementById("bannerLink").value.trim();
        const file = document.getElementById("bannerImage").files[0];

        let hasError = false;

        if (!title) {
            showFieldError("bannerTitle", "Banner title is required");
            hasError = true;
        } else if (title.length < 3) {
            showFieldError("bannerTitle", "Title must be at least 3 characters");
            hasError = true;
        }

        if (!description) {
            showFieldError("bannerDescription", "Description is required");
            hasError = true;
        } else if (description.length > 500) {
            showFieldError("bannerDescription", "Description too long (max 500 chars)");
            hasError = true;
        }

        if (link && !isValidUrl(link)) {
            showFieldError("bannerLink", "Please enter a valid URL");
            hasError = true;
        }

        if (!file && !editingBannerId) {
            showFieldError("bannerImage", "Banner image is required");
            hasError = true;
        }

        if (hasError) return;

        const formData = new FormData();
        formData.append("title", title);
        formData.append("description", description);
        formData.append("link", link); 

        if (file) formData.append("image", file);

        const url = editingBannerId ? `/api/banners/update/${editingBannerId}` : "/api/banners/create";
        const method = editingBannerId ? "PUT" : "POST";

        const btn = document.getElementById("saveBannerBtn");
        const spinner = document.getElementById("bannerSpinner");
        const btnText = document.getElementById("saveBannerBtnText");
        btn.disabled = true;
        spinner.classList.remove("hidden");
        btnText.textContent = "Saving...";

        try {
            const res = await fetch(url, { method, body: formData });
            const data = await safeParseJSON(res);

            // ✅ FIXED: Handle OBJECT errors from backend
            if (!data.success) {
                if (data.errors && typeof data.errors === 'object') {
                    // Field-specific errors { bannerTitle: "error", bannerLink: "error" }
                    Object.keys(data.errors).forEach(fieldId => {
                        showFieldError(fieldId, data.errors[fieldId]);
                    });
                    return;
                }
                throw new Error(data.message);
            }

            if (editingBannerId) {
                const index = banners.findIndex(b => b._id === editingBannerId);
                banners[index] = data.data;
            } else {
                banners.unshift(data.data);
            }

            renderBanners();
            updateBannerStats();
            showToast(editingBannerId ? "Banner updated successfully" : "Banner created successfully");
            closeBannerModal();

        } catch (err) {
            showToast(err.message || "Banner save failed", "error");
        } finally {
            btn.disabled = false;
            spinner.classList.add("hidden");
            btnText.textContent = editingBannerId ? "Update Banner" : "Save Banner";
        }
    }

    /* ================= VALID URL ================= */
    function isValidUrl(string) {
        try {
            new URL(string.startsWith('http') ? string : 'http://' + string);
            return true;
        } catch (_) {
            return false;
        }
    }

    /* ================= SHOW FIELD ERROR ================= */
    function showFieldError(fieldId, message) {
        const field = document.getElementById(fieldId);
        const errorEl = document.getElementById(fieldId + "Error");

        field.style.borderColor = "#ef4444";
        field.style.backgroundColor = "#fef2f2";
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");

        field.focus();
        field.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    /* ================= CLEAR FORM ERRORS ================= */
    function clearFormErrors() {
        ["bannerTitle", "bannerDescription", "bannerLink", "bannerImage"].forEach(fieldId => {
            const field = document.getElementById(fieldId);
            const errorEl = document.getElementById(fieldId + "Error");

            if (field) {
                field.style.borderColor = "#d1d5db";
                field.style.backgroundColor = "white";
            }
            if (errorEl) {
                errorEl.textContent = "";
                errorEl.classList.add("hidden");
            }
        });
    }

    /* ================= TOGGLE STATUS ================= */
    async function toggleBannerStatus(id, status) {
        const banner = banners.find(b => b._id === id);
        if (!banner) return;

        banner.isActive = status;
        renderBanners();
        updateBannerStats();

        try {
            const res = await fetch(`/api/banners/toggle-status/${id}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json", Accept: "application/json" },
                body: JSON.stringify({ isActive: status })
            });
            const data = await safeParseJSON(res);

            if (!data.success) throw new Error(data.message);

            showToast(`Banner ${status ? "activated" : "deactivated"} successfully`);
        } catch (err) {
            banner.isActive = !status;
            renderBanners();
            updateBannerStats();
            showToast(err.message || "Status update failed", "error");
        }
    }

    /* ================= DELETE ================= */
    async function deleteBanner(id) {
        if (!confirm("Are you sure you want to delete this banner?")) return;

        const index = banners.findIndex(b => b._id === id);
        const removed = banners.splice(index, 1);
        renderBanners();
        updateBannerStats();

        try {
            const res = await fetch(`/api/banners/delete/${id}`, { method: "DELETE", headers: { Accept: "application/json" } });
            const data = await safeParseJSON(res);

            if (!data.success) throw new Error(data.message);

            showToast("Banner deleted successfully");
        } catch (err) {
            banners.splice(index, 0, removed[0]);
            renderBanners();
            updateBannerStats();
            showToast(err.message || "Delete failed", "error");
        }
    }
    
    /* ================= TOAST ================= */
    function showToast(msg, type = "success") {

        const toast = document.getElementById("toast")

        toast.textContent = msg

        toast.className = `fixed top-3 right-6 px-4 py-2 rounded shadow text-sm z-50 text-white ${type === "success" ? "bg-green-600" : "bg-red-600"
            }`

        toast.classList.remove("hidden")

        setTimeout(() => toast.classList.add("hidden"), 3000)

    }

    /* ================= SEARCH BANNERS ================= */
    function onSearchBanner() {
        const searchTerm = document.getElementById("searchInput").value.toLowerCase().trim();

        if (!searchTerm) {
            renderBanners();
            updateBannerStats();
            return;
        }

        const filteredBanners = banners.filter(banner =>
            banner.title.toLowerCase().includes(searchTerm) ||
            (banner.description && banner.description.toLowerCase().includes(searchTerm)) ||
            (banner.link && banner.link.toLowerCase().includes(searchTerm))
        );

        const originalBanners = banners;
        banners = filteredBanners;

        renderBanners();
        updateBannerStats();

        banners = originalBanners;

    }

    document.getElementById("searchInput").addEventListener("input", function () {
        clearTimeout(this.searchTimeout);
        this.searchTimeout = setTimeout(onSearchBanner, 300);
    });

    document.getElementById("searchInput").addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
            this.value = "";
            renderBanners();
            updateBannerStats();
        }
    });

</script>