<div class="min-h-screen bg-white p-6">
  <!-- HEADER -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-10 gap-3">
    <div>
      <h1 class="text-3xl font-bold text-black-900 tracking-tight flex items-center gap-4 mb-2 drop-shadow-md">
        <i class="fas fa-layer-group text-black-400 animate-pulse"></i>
        <span>Landing Page Management</span>
      </h1>

      <span class="text-md text-gray-600 font-semibold">
        Manage homepage sections & content
      </span>
    </div>
  </div>

  <!-- STATS -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mb-10">
    <!-- Total Sections -->
    <div
      class="bg-blue-500 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-blue-100 font-bold">Total Sections</p>
          <span id="totalSections"
            class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
        </div>
        <i class="fas fa-layer-group text-5xl text-blue-200 opacity-80 group-hover:scale-125 transition"></i>
      </div>
    </div>

    <!-- Active Sections -->
    <div
      class="bg-green-500 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-green-100 font-bold">Active Sections</p>
          <span id="activeSections"
            class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
        </div>
        <i class="fas fa-check-circle text-5xl text-green-200 opacity-80 group-hover:scale-125 transition"></i>
      </div>
    </div>

    <!-- Inactive Sections -->
    <div
      class="bg-gray-500 rounded-xl p-6 shadow-xl flex flex-col gap-2 relative overflow-hidden group hover:scale-105 transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-100 font-bold">Inactive Sections</p>
          <span id="inactiveSections"
            class="text-3xl sm:text-4xl font-extrabold text-white font-mono animate-pulse">0</span>
        </div>
        <i class="fas fa-ban text-5xl text-gray-200 opacity-80 group-hover:scale-125 transition"></i>
      </div>
    </div>
  </div>

  <!-- SEARCH + CREATE -->
  <div class="flex flex-col sm:flex-row justify-between items-center gap-3 mb-6 w-full">
    <!-- Left: Search -->
    <div class="flex gap-2 w-full sm:w-auto">
      <input id="searchInput" placeholder="Search section name..."
        class="border border-gray-300 rounded px-2 py-2 w-full sm:w-56 text-xs bg-white focus:outline-none focus:ring-1 focus:ring-blue-400" />

      <button onclick="onSearchSection()"
        class="flex items-center gap-1 px-3 py-2 text-xs font-medium text-white bg-blue-600 rounded hover:bg-blue-700">
        <i class="fas fa-search text-[10px]"></i>
        Search
      </button>
    </div>

    <!-- Right: Create Section Button -->
    <div class="w-full sm:w-auto flex justify-start sm:justify-end">
      <button onclick="openCreateModal()"
        class="flex items-center gap-1 px-4 py-2 text-xs font-medium text-white bg-green-600 rounded hover:bg-green-700 transition duration-300">
        <i class="fas fa-plus text-[10px]"></i>
        Section
      </button>
    </div>
  </div>

  <!-- TABLE -->
  <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-x-auto">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[700px] border border-gray-200 text-sm table-fixed">
        <thead class="bg-gradient-to-r from-gray-50 via-gray-100 to-white">
          <tr class="uppercase">
            <th class="px-4 py-2 text-xs font-bold w-[60px] text-center">#</th>
            <th class="px-4 py-2 text-xs font-bold text-center">Section Name</th>
            <th class="px-4 py-2 text-xs font-bold text-center">Content</th>
            <th class="px-4 py-2 text-xs font-bold w-[100px] text-center">Status</th>
            <th class="px-4 py-2 text-xs font-bold w-[150px] text-center">Created</th>
            <th class="px-4 py-2 text-xs font-bold w-[140px] text-center">Action</th>
          </tr>
        </thead>

        <tbody id="sectionTable" class="divide-y font-mono">
          <!-- rows via JS -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- MODAL -->
  <div id="sectionModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white w-full max-w-xl rounded-xl shadow-2xl p-6 relative animate-fade-in">
      <!-- Header -->
      <div class="flex justify-between items-center mb-4">
        <h2 id="modalTitle" class="text-lg font-bold text-gray-800">
          Create Section
        </h2>

        <button onclick="closeSectionModal()" class="text-gray-500 hover:text-red-500">
          <i class="fas fa-times text-lg"></i>
        </button>
      </div>

      <!-- FORM -->
      <form id="sectionForm" onsubmit="saveSection(event)" class="space-y-4">
        <input type="hidden" id="sectionId" />

        <!-- SECTION NAME -->
        <div>
          <label class="text-xs font-bold text-gray-600">Section Name *</label>
          <input id="sectionName" type="text"
            class="w-full border-2 rounded px-3 py-2 text-sm focus:ring-1 focus:ring-blue-400 transition-all duration-200"
            style="border-color: #d1d5db;">
          <p id="sectionNameError" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>

        <!-- CONTENT -->
        <div>
          <label class="text-xs font-bold text-gray-600">Content (JSON)</label>
          <textarea id="sectionContent" rows="6"
            class="w-full border-2 rounded px-3 py-2 text-sm focus:ring-0 focus:ring-blue-400 transition-all duration-200"
            style="border-color: #d1d5db;" placeholder='{"key": "value"}'></textarea>
          <p id="sectionContentError" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="flex justify-end gap-2 pt-2">
          <button type="submit" id="saveSectionBtn"
            class="px-4 py-2 text-xs rounded bg-blue-600 text-white hover:bg-blue-700 transition duration-300 flex items-center justify-center gap-2">
            <svg id="sectionSpinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg"
              fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
            </svg>
            <span id="saveSectionBtnText">Save Section</span>
          </button>
          <button type="button" onclick="closeSectionModal()"
            class="px-4 py-2 text-xs rounded bg-gray-400 text-white hover:bg-gray-500 transition duration-300">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="mt-4 text-center">
    <button id="loadMoreSectionsBtn"
      class="inline-flex items-center justify-center gap-1 bg-gray-400 text-white px-3 py-2 rounded-md text-xs font-medium hover:bg-gray-500 transition hidden w-full sm:w-auto mb-4"
      onclick="fetchSections()">
      <i class="fas fa-arrow-down text-[10px]"></i>
      Load More
    </button>
  </div>

  <!-- TOAST -->
  <div id="toast" class="fixed top-3 right-2 md:right-6 px-4 py-2 rounded shadow hidden z-50 text-white text-sm"></div>
</div>

<script>
  let allSections = [];
  let sections = [];
  let sectionCursor = null;
  const sectionLimit = 5;
  let editingSectionId = null;
  let currentSearch = "";

  /* ================= SAFE PARSE JSON ================= */
  async function safeParseJSON(res) {
    const text = await res.text();
    let json = {};
    try { json = text ? JSON.parse(text) : {}; } catch { }
    return { ok: res.ok, status: res.status, body: json };
  }

  /* ================= ANIMATE NUMBER ================= */
  function animateNumber(id, start, end, duration = 800) {
    const el = document.getElementById(id);
    if (!el) return;
    let startTime = null;
    function step(timestamp) {
      if (!startTime) startTime = timestamp;
      const progress = Math.min((timestamp - startTime) / duration, 1);
      el.textContent = Math.floor(progress * (end - start) + start);
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  /* ================= EXACPE HTML ================= */
  function escapeHTML(str) {
    if (typeof str !== "string") return "";
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  /* ================= FETCH SECTIONS ================= */
  async function fetchSections(reset = false, search = currentSearch) {
    if (reset) {
      allSections = [];
      sections = [];
      sectionCursor = null;
    }

    let url = `/api/landing-pages/all-sections?limit=${sectionLimit}`;
    if (sectionCursor) url += `&cursor=${encodeURIComponent(sectionCursor)}`;
    if (search) url += `&search=${encodeURIComponent(search)}`;

    try {
      const { ok, status, body } = await safeParseJSON(
        await fetch(url, { headers: { Accept: "application/json" } })
      );
      if (!ok || !body.success) throw new Error(body.message || `Request failed with ${status}`);

      allSections = [...allSections, ...body.data];
      sections = [...allSections];
      renderSections();
      updateSectionStats();

      sectionCursor = body.nextCursor || null;
      document
        .getElementById("loadMoreSectionsBtn")
        .classList.toggle("hidden", !sectionCursor);
    } catch (err) {
      showToast(err.message || "Failed to fetch sections", "error");
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    fetchSections(true);
  });

  /* ================= UPDATE SECTIONS STATS ================= */
  function updateSectionStats() {
    const total = allSections.length;
    const active = allSections.filter((s) => s.isActive).length;
    const inactive = total - active;

    animateNumber(
      "totalSections",
      parseInt(document.getElementById("totalSections").textContent) || 0,
      total,
      600
    );
    animateNumber(
      "activeSections",
      parseInt(document.getElementById("activeSections").textContent) || 0,
      active,
      600
    );
    animateNumber(
      "inactiveSections",
      parseInt(document.getElementById("inactiveSections").textContent) || 0,
      inactive,
      600
    );
  }

  /* ================= RENDER SECTIONS ================= */
  function renderSections() {
    const tbody = document.getElementById("sectionTable");
    tbody.innerHTML = "";
    if (!sections.length) {
      tbody.innerHTML = `<tr><td colspan="6" class="text-center py-6 bg-white text-gray-500 font-semibold">Sections not found</td></tr>`;
      return;
    }
    sections.forEach((s, i) => {
      const tr = document.createElement("tr");
      tr.setAttribute("data-id", s._id);
      tr.innerHTML = `

<td class="px-4 py-3 text-xs font-semibold text-gray-500 text-center w-[60px]">
${i + 1}.
</td>

<td class="px-4 py-3 font-semibold text-gray-800 text-sm text-center truncate max-w-[160px]">
${escapeHTML(s.sectionName)}
</td>

<td class="px-4 py-3 text-sm text-left max-w-[240px]">
<div class="font-medium text-gray-800 truncate text-xs">
${escapeHTML(s.content?.title || "")}
</div>
<div class="text-gray-500 text-[11px] truncate">
${escapeHTML(s.content?.subtitle || "")}
</div>
<div class="text-blue-600 text-[11px] font-semibold truncate">
${escapeHTML(s.content?.buttonText || "")}
</div>
</td>

<td class="px-4 py-3 text-center">
<span class="px-3 py-1 text-xs font-semibold rounded-full ${s.isActive
          ? "bg-green-100 text-green-700"
          : "bg-gray-200 text-gray-600"
        }">
${s.isActive ? "Active" : "Inactive"}
</span>
</td>

<td class="px-4 py-3 text-center">
<div class="text-black-800 text-xs font-medium">
${s.createdAt ? new Date(s.createdAt).toLocaleDateString() : "-"}
</div>
<div class="text-gray-400 text-xs">
${s.createdAt ? new Date(s.createdAt).toLocaleTimeString() : ""}
</div>
</td>

<td class="px-4 py-3 text-center w-[140px]">
  <div class="flex justify-center gap-2">

    <button
      onclick="toggleSectionStatus('${s._id}', ${!s.isActive})"
      class="w-7 h-7 flex items-center justify-center rounded-md bg-gray-100 text-gray-600 hover:bg-gray-200 transition"
      title="Toggle Status">
      <i class="fas fa-toggle-${s.isActive ? "on" : "off"} text-xs"></i>
    </button>

    <button
      onclick="openEditSectionModal('${s._id}')"
      class="w-7 h-7 flex items-center justify-center rounded-md bg-yellow-100 text-yellow-600 hover:bg-yellow-200 transition"
      title="Edit">
      <i class="fas fa-edit text-xs"></i>
    </button>

    <button
      onclick="deleteSection('${s._id}')"
      class="w-7 h-7 flex items-center justify-center rounded-md bg-red-100 text-red-600 hover:bg-red-200 transition"
      title="Delete">
      <i class="fas fa-trash text-xs"></i>
    </button>

  </div>
</td>
`;
      tbody.appendChild(tr);
    });
  }

  /* ================= SEARCH ================= */
  function onSearchSection() {
    currentSearch = document.getElementById("searchInput").value.trim();
    fetchSections(true, currentSearch);
  }

  /* ================= MODAL ================= */
  function openCreateModal() {
    editingSectionId = null;
    document.getElementById("modalTitle").textContent = "Create Section";
    document.getElementById("saveSectionBtnText").textContent = "Save Section";
    document.getElementById("sectionForm").reset();
    clearFormErrors();
    document.getElementById("sectionModal").classList.remove("hidden");
    document.getElementById("sectionModal").classList.add("flex");
  }

  /* ================= OPEN EDIT SECTIONS ================= */
  function openEditSectionModal(id) {
    const s = allSections.find((sec) => sec._id === id);
    if (!s) return;
    editingSectionId = id;
    document.getElementById("modalTitle").textContent = "Update Section";
    document.getElementById("saveSectionBtnText").textContent = "Update Section";
    document.getElementById("sectionName").value = s.sectionName;
    document.getElementById("sectionContent").value = JSON.stringify(s.content, null, 2);
    clearFormErrors();
    document.getElementById("sectionModal").classList.remove("hidden");
    document.getElementById("sectionModal").classList.add("flex");
  }

  /* ================= CLOSE SECTION MODEL ================= */
  function closeSectionModal() {
    document.getElementById("sectionModal").classList.add("hidden");
    document.getElementById("sectionModal").classList.remove("flex");
    editingSectionId = null;
  }

  /* ================= SAVE / UPDATE ================= */
  async function saveSection(e) {
    e.preventDefault();
    clearFormErrors();

    const name = document.getElementById("sectionName").value.trim();
    const contentStr = document.getElementById("sectionContent").value.trim();
    let content = {},
      hasError = false;

    if (!name) {
      showFieldError("sectionName", "Section name is required");
      hasError = true;
    }

    try {
      content = contentStr ? JSON.parse(contentStr) : {};
      if (Object.keys(content).length === 0) {
        showFieldError("sectionContent", "Content cannot be empty");
        hasError = true;
      }
    } catch {
      showFieldError("sectionContent", "Invalid JSON content");
      hasError = true;
    }

    if (hasError) return;

    const url = "/api/landing-pages/upsert-section";
    const btn = document.getElementById("saveSectionBtn");
    const spinner = document.getElementById("sectionSpinner");
    const btnText = document.getElementById("saveSectionBtnText");

    btn.disabled = true;
    spinner.classList.remove("hidden");
    btnText.textContent = "Saving...";

    const startTime = Date.now();

    try {
      const { ok, status, body } = await safeParseJSON(
        await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ sectionName: name, content }),
        })
      );

      const elapsed = Date.now() - startTime;
      if (elapsed < 3000) {
        await new Promise((resolve) => setTimeout(resolve, 3000 - elapsed));
      }

      if (!ok || !body.success) {
        if (status === 400 && body.error && body.error.errors) {
          Object.keys(body.error.errors).forEach((field) => {
            const msg = body.error.errors[field]?.message || "Invalid value";
            if (field === "sectionName") showFieldError("sectionName", msg);
            if (field === "content") showFieldError("sectionContent", msg);
          });
          showToast(body.message || "Validation failed", "error");
          return;
        }

        if (status === 400 && body.duplicateField && body.duplicateField.sectionName) {
          showFieldError("sectionName", body.message || "Section name already exists");
          showToast(body.message || "Duplicate section name", "error");
          return;
        }

        throw new Error(body.message || `Request failed with ${status}`);
      }

      const saved = body.data;
      const existingIdx = allSections.findIndex((s) => s._id === saved._id);
      if (existingIdx > -1) allSections[existingIdx] = saved;
      else allSections.unshift(saved);
      sections = [...allSections];
      renderSections();
      updateSectionStats();
      showToast(
        editingSectionId ? "Section updated successfully" : "Section created successfully",
        "success"
      );
      closeSectionModal();
    } catch (err) {
      const elapsed = Date.now() - startTime;
      if (elapsed < 3000) {
        await new Promise((resolve) => setTimeout(resolve, 3000 - elapsed));
      }
      showToast(err.message || "Save failed", "error");
    } finally {
      btn.disabled = false;
      spinner.classList.add("hidden");
      btnText.textContent = editingSectionId ? "Update Section" : "Save Section";
    }
  }

  /* ================= FIELD ERROR ================= */
  function showFieldError(fieldId, message) {
    const field = document.getElementById(fieldId);
    const errorEl = document.getElementById(fieldId + "Error");
    field.style.borderColor = "#ef4444";
    field.style.backgroundColor = "#fef2f2";
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
    field.focus();
    field.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  /* ================= CLEAR FORM ERRORS ================= */
  function clearFormErrors() {
    ["sectionName", "sectionContent"].forEach((id) => {
      const f = document.getElementById(id),
        e = document.getElementById(id + "Error");
      if (f) {
        f.style.borderColor = "#d1d5db";
        f.style.backgroundColor = "white";
      }
      if (e) {
        e.textContent = "";
        e.classList.add("hidden");
      }
    });
  }

  /* ================= SHOW TOAST ================= */
  function showToast(msg, type = "success") {
    const toast = document.getElementById("toast");
    toast.textContent = msg;
    toast.className = `fixed top-3 right-6 px-4 py-2 rounded shadow text-sm z-50 text-white ${type === "success" ? "bg-green-600" : "bg-red-600"
      }`;
    toast.classList.remove("hidden");
    setTimeout(() => toast.classList.add("hidden"), 3000);
  }

  /* ================= DELETE / TOGGLE ================= */
  async function deleteSection(id) {
    if (!confirm("Are you sure to delete this section?")) return;

    const idx = allSections.findIndex((s) => s._id === id);
    if (idx === -1) return;

    const removed = allSections.splice(idx, 1);
    sections = [...allSections];
    renderSections();
    updateSectionStats();

    try {
      const { ok, status, body } = await safeParseJSON(
        await fetch(`/api/landing-pages/delete-section/${id}`, {
          method: "DELETE",
          headers: { Accept: "application/json" },
        })
      );
      if (!ok || !body.success) throw new Error(body.message || `Request failed with ${status}`);
      showToast("Section deleted successfully", "success");
    } catch (err) {
      allSections.splice(idx, 0, removed[0]);
      sections = [...allSections];
      renderSections();
      updateSectionStats();
      showToast(err.message || "Delete failed", "error");
    }
  }

  /* ================= TOGGLE SECTION STATUS ================= */
  async function toggleSectionStatus(id, status) {
    const s = allSections.find((sec) => sec._id === id);
    if (!s) return;

    s.isActive = status;
    sections = [...allSections];
    renderSections();
    updateSectionStats();

    try {
      const { ok, status: httpStatus, body } = await safeParseJSON(
        await fetch(`/api/landing-pages/toggle-section/${id}`, {
          method: "PATCH",
          headers: { Accept: "application/json" },
        })
      );
      if (!ok || !body.success) throw new Error(body.message || `Request failed with ${httpStatus}`);

      const updated = body.data;
      const idx = allSections.findIndex((sec) => sec._id === id);
      if (idx > -1) allSections[idx] = updated;
      sections = [...allSections];

      renderSections();
      updateSectionStats();
      showToast(
        `Section ${updated.isActive ? "activated" : "deactivated"} successfully`,
        "success"
      );
    } catch (err) {
      s.isActive = !status;
      sections = [...allSections];
      renderSections();
      updateSectionStats();
      showToast(err.message || "Status update failed", "error");
    }
  }

  window.deleteSection = deleteSection;
  window.toggleSectionStatus = toggleSectionStatus;
  window.openEditSectionModal = openEditSectionModal;
  window.openCreateModal = openCreateModal;
  window.onSearchSection = onSearchSection;

  document.addEventListener("click", function (e) {
    if (e.target.closest(".delete-btn")) {
      const id = e.target.closest(".delete-btn").dataset.id;
      deleteSection(id);
    }
  });
</script>