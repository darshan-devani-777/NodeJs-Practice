<%- include('../layouts/header') %>

<div class="flex justify-center items-center flex-grow p-4 sm:p-6">
  <div class="w-full max-w-sm sm:max-w-md bg-white p-4 sm:p-6 rounded-xl shadow-lg">
    <h2 class="text-xl font-bold text-center mb-4 underline">Reset Password</h2>

    <form id="resetForm" class="space-y-4">
      <!-- New Password -->
      <div>
        <div class="relative">
          <input name="password" id="password" type="password" placeholder="New Password"
            class="w-full p-2 border rounded-md text-sm pr-10">
          <button type="button" id="togglePassword"
            class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-600 hover:text-gray-900">
            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </button>
        </div>
        <p class="text-red-600 text-xs mt-1 hidden" id="passwordError"></p>
      </div>

      <!-- Confirm Password -->
      <div>
        <div class="relative">
          <input name="confirmPassword" id="confirmPassword" type="password" placeholder="Confirm Password"
            class="w-full p-2 border rounded-md text-sm pr-10">
          <button type="button" id="toggleConfirmPassword"
            class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-600 hover:text-gray-900">
            <svg id="eyeConfirmIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </button>
        </div>
        <p class="text-red-600 text-xs mt-1 hidden" id="confirmError"></p>
      </div>

      <!-- Submit -->
      <button type="submit" id="resetBtn"
        class="w-full bg-blue-600 text-white py-2 rounded-md text-sm hover:bg-blue-700 transition flex justify-center items-center">
        <span id="btnText">Reset Password</span>
        <svg id="loader" class="animate-spin h-5 w-5 ml-2 hidden text-white" xmlns="http://www.w3.org/2000/svg" fill="none"
          viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor"
            d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </button>

      <p class="mt-2 text-green-700 text-sm hidden" id="successMsg"></p>
    </form>

    <p class="text-center mt-4 text-sm">
      <a href="/login" class="text-blue-600 hover:underline">Back to Login</a>
    </p>
  </div>
</div>

<script>
  // --- Toggle Password Fields ---
  const togglePassword = document.getElementById('togglePassword');
  const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
  const passwordInput = document.getElementById('password');
  const confirmInput = document.getElementById('confirmPassword');
  const eyeIcon = document.getElementById('eyeIcon');
  const eyeConfirmIcon = document.getElementById('eyeConfirmIcon');

  togglePassword.addEventListener('click', () => {
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.957 9.957 0 012.347-3.672m1.464-1.464A9.957 9.957 0 0112 5c4.478 0 8.268 2.943 9.542 7a9.958 9.958 0 01-4.97 5.946M3 3l18 18"/>`;
    } else {
      passwordInput.type = 'password';
      eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
    }
  });

  toggleConfirmPassword.addEventListener('click', () => {
    if (confirmInput.type === 'password') {
      confirmInput.type = 'text';
      eyeConfirmIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.957 9.957 0 012.347-3.672m1.464-1.464A9.957 9.957 0 0112 5c4.478 0 8.268 2.943 9.542 7a9.958 9.958 0 01-4.97 5.946M3 3l18 18"/>`;
    } else {
      confirmInput.type = 'password';
      eyeConfirmIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
    }
  });

  // --- Form Submission with Loader ---
  const resetForm = document.getElementById('resetForm');
  const btnText = document.getElementById('btnText');
  const loader = document.getElementById('loader');

  resetForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    ['passwordError', 'confirmError', 'successMsg'].forEach(id => document.getElementById(id).classList.add('hidden'));
    ['password', 'confirmPassword'].forEach(id => document.getElementById(id).classList.remove('border-red-500'));

    const password = passwordInput.value;
    const confirmPassword = confirmInput.value;
    let hasError = false;

    if (password.length < 6) {
      const el = document.getElementById('passwordError');
      el.textContent = 'Password must be 6+ characters';
      el.classList.remove('hidden');
      passwordInput.classList.add('border-red-500');
      hasError = true;
    }

    if (confirmPassword !== password) {
      const el = document.getElementById('confirmError');
      el.textContent = 'Passwords do not match';
      el.classList.remove('hidden');
      confirmInput.classList.add('border-red-500');
      hasError = true;
    }

    if (hasError) return;

    // Show loader
    btnText.classList.add('hidden');
    loader.classList.remove('hidden');

    try {
      const res = await fetch(`/api/auth/resetpassword/<%= token %>`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password, confirmPassword })
      });

      const data = await res.json();

      // Hide loader
      loader.classList.add('hidden');
      btnText.classList.remove('hidden');

      if (data.success) {
        const successEl = document.getElementById('successMsg');
        successEl.textContent = data.message;
        successEl.classList.remove('hidden');
        resetForm.reset();

        setTimeout(() => {
          window.location.href = '/login';
        }, 1500);
      } else {
        alert(data.message);
      }

    } catch (err) {
      loader.classList.add('hidden');
      btnText.classList.remove('hidden');
      alert('Server error');
    }
  });
</script>

<%- include('../layouts/footer') %>
