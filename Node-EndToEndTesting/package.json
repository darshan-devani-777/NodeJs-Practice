{
  "name": "nodejs-e2e-testing-demo",
  "version": "1.0.0",
  "description": "Production-ready end-to-end testing demo for Node.js backend developers",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:unit": "node node_modules/.bin/jest tests/unit --passWithNoTests",
    "test:integration": "node node_modules/.bin/jest tests/integration/userRoutes.test.js --passWithNoTests",
    "test:e2e-api": "node node_modules/.bin/jest tests/integration/api-e2e.test.js --passWithNoTests",
    "test:e2e-browser": "npx playwright test tests/playwright",
    "test:full": "node run-tests.js",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": [
    "nodejs",
    "testing",
    "api",
    "jest",
    "supertest",
    "mongodb"
  ],
  "author": "Backend Developer Demo",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "mongodb-memory-server": "^9.1.1",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 10000,
    "testPathIgnorePatterns": [
      "<rootDir>/tests/playwright/"
    ]
  }
}
