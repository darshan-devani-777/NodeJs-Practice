<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= blog.title %> | Prega Center</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f8f9fa;
        }
        
        .blog-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 60px 0;
            margin-bottom: 40px;
        }
        
        .blog-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }
        
        .blog-meta {
            font-size: 1.1rem;
            opacity: 0.9;
        }
        
        .blog-content {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 40px;
            margin-bottom: 40px;
        }
        
        .blog-content h1, 
        .blog-content h2, 
        .blog-content h3, 
        .blog-content h4, 
        .blog-content h5, 
        .blog-content h6 {
            color: #2c3e50;
            margin-top: 30px;
            margin-bottom: 20px;
            font-weight: 600;
        }
        
        .blog-content h1 { font-size: 2.2rem; }
        .blog-content h2 { font-size: 1.8rem; }
        .blog-content h3 { font-size: 1.5rem; }
        .blog-content h4 { font-size: 1.3rem; }
        .blog-content h5 { font-size: 1.1rem; }
        .blog-content h6 { font-size: 1rem; }
        
        .blog-content p {
            font-size: 1.1rem;
            margin-bottom: 20px;
            text-align: justify;
            line-height: 1.8;
        }
        
        .blog-content strong,
        .blog-content b {
            font-weight: 700;
            color: #2c3e50;
        }
        
        .blog-content em,
        .blog-content i {
            font-style: italic;
            color: #7f8c8d;
        }
        
        .blog-content blockquote {
            border-left: 4px solid #007bff;
            padding-left: 20px;
            margin: 25px 0;
            font-style: italic;
            color: #6c757d;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
        }
        
        .blog-content ul, 
        .blog-content ol {
            margin-bottom: 20px;
            padding-left: 30px;
        }
        
        .blog-content li {
            margin-bottom: 10px;
            font-size: 1.1rem;
        }
        
        .highlight-box {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin: 25px 0;
            box-shadow: 0 5px 15px rgba(0,123,255,0.3);
            text-align: center;
            font-weight: 600;
            font-size: 1.2rem;
        }
        
        /* Additional styling for content elements */
        .blog-content .highlight-box,
        .blog-content .info-box,
        .blog-content .tip-box,
        .blog-content .warning-box {
            margin: 25px 0;
            padding: 20px;
            border-radius: 10px;
            font-weight: 500;
        }
        
        .blog-content .highlight-box {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            color: white;
            text-align: center;
            font-size: 1.2rem;
            box-shadow: 0 5px 15px rgba(0,123,255,0.3);
        }
        
        .blog-content .info-box {
            background: #e3f2fd;
            border-left: 5px solid #2196f3;
            color: #1565c0;
        }
        
        .blog-content .tip-box {
            background: #f3e5f5;
            border-left: 5px solid #9c27b0;
            color: #7b1fa2;
        }
        
        .blog-content .warning-box {
            background: #fff3e0;
            border-left: 5px solid #ff9800;
            color: #ef6c00;
        }
        
        /* Style for inline highlight boxes (like the blue box in your image) */
        .blog-content .inline-highlight {
            display: inline-block;
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            color: white;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 1rem;
            margin: 0 5px;
            box-shadow: 0 3px 10px rgba(0,123,255,0.3);
        }
        
        .info-box {
            background: #e3f2fd;
            border-left: 5px solid #2196f3;
            padding: 20px;
            margin: 25px 0;
            border-radius: 5px;
        }
        
        .tip-box {
            background: #f3e5f5;
            border-left: 5px solid #9c27b0;
            padding: 20px;
            margin: 25px 0;
            border-radius: 5px;
        }
        
        .warning-box {
            background: #fff3e0;
            border-left: 5px solid #ff9800;
            padding: 20px;
            margin: 25px 0;
            border-radius: 5px;
        }
        
        .blog-image {
            width: 100%;
            max-width: 600px;
            height: auto;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            margin: 30px auto;
            display: block;
        }
        
        .back-button {
            background: #6c757d;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .back-button:hover {
            background: #5a6268;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .blog-footer {
            background: #343a40;
            color: white;
            padding: 30px 0;
            margin-top: 40px;
        }
        
        .social-share {
            margin-top: 20px;
        }
        
        .social-share a {
            color: white;
            margin: 0 10px;
            font-size: 1.5rem;
            transition: all 0.3s ease;
        }
        
        .social-share a:hover {
            color: #007bff;
            transform: scale(1.2);
        }
        
        @media (max-width: 768px) {
            .blog-title {
                font-size: 2rem;
            }
            
            .blog-content {
                padding: 25px;
            }
            
            .blog-header {
                padding: 40px 0;
            }
        }
    </style>
</head>
<body>
    <!-- Blog Header -->
    <div class="blog-header">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <h1 class="blog-title"><%= blog.title %></h1>
                    <div class="blog-meta">
                        <i class="fas fa-calendar-alt"></i> <%= new Date(blog.created_at).toLocaleDateString() %>
                        <% if (blog.author) { %>
                            <span class="mx-3">|</span>
                            <i class="fas fa-user"></i> <%= blog.author %>
                        <% } %>
                        <% if (blog.type) { %>
                            <span class="mx-3">|</span>
                            <i class="fas fa-tag"></i> <%= blog.type.charAt(0).toUpperCase() + blog.type.slice(1) %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <div class="row">
            <div class="col-12">
                <!-- Back Button -->
                <div class="text-start mb-4">
                    <a href="/blogs" class="back-button">
                        <i class="fas fa-arrow-left"></i> Back to Blogs
                    </a>
                </div>

                <!-- Blog Image -->
                <% if (blog.image_url) { %>
                    <div class="text-center">
                        <img src="<%= blog.image_url %>" alt="<%= blog.title %>" class="blog-image">
                    </div>
                <% } %>

                <!-- Blog Description -->
                <% if (blog.description) { %>
                    <div class="blog-content">
                        <h3>Summary</h3>
                        <p><%= blog.description %></p>
                    </div>
                <% } %>

                <!-- Blog Content -->
                <div class="blog-content">
                    <%- blog.content %>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="blog-footer">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <h5>Share this article</h5>
                    <div class="social-share">
                        <a href="#" onclick="shareOnFacebook()" title="Share on Facebook">
                            <i class="fab fa-facebook"></i>
                        </a>
                        <a href="#" onclick="shareOnTwitter()" title="Share on Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" onclick="shareOnLinkedIn()" title="Share on LinkedIn">
                            <i class="fab fa-linkedin"></i>
                        </a>
                        <a href="#" onclick="copyLink()" title="Copy Link">
                            <i class="fas fa-link"></i>
                        </a>
                    </div>
                    <p class="mt-3">&copy; 2024 Prega Center. All rights reserved.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function shareOnFacebook() {
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent('<%= blog.title %>');
            window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank');
        }
        
        function shareOnTwitter() {
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent('<%= blog.title %>');
            window.open(`https://twitter.com/intent/tweet?url=${url}&text=${title}`, '_blank');
        }
        
        function shareOnLinkedIn() {
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent('<%= blog.title %>');
            window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}`, '_blank');
        }
        
        function copyLink() {
            navigator.clipboard.writeText(window.location.href).then(function() {
                alert('Link copied to clipboard!');
            });
        }
    </script>
</body>
</html>
