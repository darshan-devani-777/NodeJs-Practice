<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Prega Center | Articles </title>

  <%- include('partial/scripts') %>

  <style>
    /* Table horizontal scrolling styles */
    .table-responsive {
      overflow-x: auto;
      overflow-y: hidden;
      white-space: nowrap;
      max-width: 100%;
    }
    
    .table-responsive table {
      min-width: 100%;
      width: max-content;
    }
    
    .table-responsive th,
    .table-responsive td {
      white-space: nowrap;
      min-width: 60px;
    }
    
    /* Specific column widths for better layout */
    .table-responsive th:nth-child(1), /* ID */
    .table-responsive td:nth-child(1) {
      min-width: 60px;
      max-width: 60px;
    }
    
    .table-responsive th:nth-child(2), /* Title */
    .table-responsive td:nth-child(2) {
      min-width: 120px;
      max-width: 120px;
    }
    
    .table-responsive th:nth-child(3), /* Content */
    .table-responsive td:nth-child(3) {
      min-width: 200px;
      max-width: 200px;
    }
    
    .table-responsive th:nth-child(4), /* Image */
    .table-responsive td:nth-child(4) {
      min-width: 80px;
      max-width: 80px;
    }
    
    .table-responsive th:nth-child(5), /* Type */
    .table-responsive td:nth-child(5) {
      min-width: 80px;
      max-width: 80px;
    }
    
    .table-responsive th:nth-child(6), /* Tag */
    .table-responsive td:nth-child(6) {
      min-width: 80px;
      max-width: 80px;
    }
    
    .table-responsive th:nth-child(7), /* Topic */
    .table-responsive td:nth-child(7) {
      min-width: 100px;
      max-width: 100px;
    }
    
    .table-responsive th:nth-child(8), /* Posted By */
    .table-responsive td:nth-child(8) {
      min-width: 100px;
      max-width: 100px;
    }
    
    .table-responsive th:nth-child(9), /* Action */
    .table-responsive td:nth-child(9) {
      min-width: 120px;
      max-width: 120px;
    }
    
    /* DataTable specific scrolling and pagination styles */
    .dataTables_wrapper {
      /* overflow-x: auto; */
      max-width: 100%;
      position: relative;
    }
    
    .dataTables_wrapper .dataTable {
      min-width: 100%;
      width: max-content !important;
    }
    
    .dataTables_wrapper .dataTable th,
    .dataTables_wrapper .dataTable td {
      white-space: nowrap;
      min-width: 60px;
    }
    
    /* Specific column widths for DataTable */
    .dataTables_wrapper .dataTable th:nth-child(1),
    .dataTables_wrapper .dataTable td:nth-child(1) {
      min-width: 100px;
      max-width: 100px;
    }
    
    .dataTables_wrapper .dataTable th:nth-child(2),
    .dataTables_wrapper .dataTable td:nth-child(2) {
      min-width: 120px;
      max-width: 120px;
    }
    
    .dataTables_wrapper .dataTable th:nth-child(3),
    .dataTables_wrapper .dataTable td:nth-child(3) {
      min-width: 100px;
      max-width: 100px;
    }
    
    .dataTables_wrapper .dataTable th:nth-child(4),
    .dataTables_wrapper .dataTable td:nth-child(4) {
      min-width: 80px;
      max-width: 80px;
    }
    
    .dataTables_wrapper .dataTable th:nth-child(5),
    .dataTables_wrapper .dataTable td:nth-child(5) {
      min-width: 80px;
      max-width: 80px;
    }
    
    .dataTables_wrapper .dataTable th:nth-child(6),
    .dataTables_wrapper .dataTable td:nth-child(6) {
      min-width: 80px;
      max-width: 80px;
    }
    
    .dataTables_wrapper .dataTable th:nth-child(7),
    .dataTables_wrapper .dataTable td:nth-child(7) {
      min-width: 100px;
      max-width: 100px;
    }
    
    .dataTables_wrapper .dataTable th:nth-child(8),
    .dataTables_wrapper .dataTable td:nth-child(8) {
      min-width: 170px;
      max-width: 170px;
    }
    
    .dataTables_wrapper .dataTable th:nth-child(9),
    .dataTables_wrapper .dataTable td:nth-child(9) {
      min-width: 170px;
      max-width: 170px;
    }
    
    /* Pagination positioning styles */
    .dataTables_wrapper .dataTables_paginate {
      position: sticky;
      bottom: 0;
      background: white;
      padding: 10px 0;
      border-top: 1px solid #dee2e6;
      z-index: 100;
      width: 100%;
      left: 0;
      right: 0;
    }
    
    .dataTables_wrapper .dataTables_info {
      position: sticky;
      bottom: 0;
      background: white;
      padding: 10px 0;
      border-top: 1px solid #dee2e6;
      z-index: 100;
      width: 100%;
      left: 0;
      right: 0;
    }
    
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
      position: sticky;
      top: 0;
      background: white;
      padding: 10px 0;
      border-bottom: 1px solid #dee2e6;
      z-index: 100;
      width: 100%;
      left: 0;
      right: 0;
    }
    
    /* Ensure consistent scrolling across all pages */
    .dataTables_wrapper .dataTables_scrollBody {
      overflow-x: auto !important;
      overflow-y: auto !important;
    }
    
    .dataTables_wrapper .dataTables_scrollHead {
      overflow: visible !important;
    }
    
    /* Force horizontal scrollbar to always show */
    .dataTables_wrapper .dataTables_scrollBody::-webkit-scrollbar {
      height: 8px;
    }
    
    .dataTables_wrapper .dataTables_scrollBody::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    
    .dataTables_wrapper .dataTables_scrollBody::-webkit-scrollbar-thumb {
      background: #888;
      border-radius: 4px;
    }
    
    .dataTables_wrapper .dataTables_scrollBody::-webkit-scrollbar-thumb:hover {
      background: #555;
    }
    
    /* Text truncation for long content */
    .dataTables_wrapper .dataTable td {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    
    /* Ensure sticky elements work properly */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
      position: -webkit-sticky;
      position: sticky;
    }
    
    /* Container positioning for sticky elements */
    .card-body {
      position: relative;
    }
    
    /* Force table to respect column widths */
    .dataTables_wrapper .dataTable {
      table-layout: fixed;
    }
    
    .dataTables_wrapper .dataTable th,
    .dataTables_wrapper .dataTable td {
      box-sizing: border-box;
    }
    #articles_table{
      width: 100% !important;
      max-width: none !important;
      overflow: auto;
    }
    @media (min-width: 1100px) {
      .dataTables_wrapper .dataTable th,
      .dataTables_wrapper .dataTable td {
          min-width: 180px !important;
          max-width: 180px !important;
          width: auto !important;
      }
    }
    @media (min-width: 1700px) {
      .dataTables_wrapper .dataTable th,
      .dataTables_wrapper .dataTable td {
          min-width: 300px !important;
          max-width: 300px !important;
          width: auto !important;
      }
    }
   
  </style>

</head>

<body class="hold-transition sidebar-mini">
  <script src="/js/articles.js"></script>
  <div class="wrapper">
    <!-- Navbar -->
    <%- include('partial/navbar') %>
      <!-- /.navbar -->

      <!-- Main Sidebar Container -->
      <%- include('partial/sidebar') %>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
          <!-- Content Header (Page header) -->
          <section class="content-header">
            <div class="container-fluid">
              <div class="row mb-2">
                <div class="col-sm-6">
                  <h1>Articles</h1>
                </div>
                <div class="col-sm-6">
                  <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/users/admin/dashboard">Home</a></li>
                    <li class="breadcrumb-item active">Articles</li>
                  </ol>
                </div>
              </div>
            </div><!-- /.container-fluid -->
          </section>

          <!-- Main content -->
          <section class="content">
            <div class="container-fluid">
              <div class="row">

                <div class="col-12">

                  <!-- /.card -->

                  <div class="card">
                    <!-- /.card-header -->
                    <div
                      style="margin: 20px 20px 0 20px; display:flex; align-items: flex-start; justify-content: space-between;">
                      <button type="button" class="btn btn-block btn-primary col-sm-1 " data-toggle="modal"
                        data-target="#modal-create">
                        <i class="fas fa-user-plus"></i> &nbsp;
                        <spna>Create</spna>
                      </button>
                    </div>
                    <div class="card-body">
                      <div class="">
                        <table id="articles_table" class="table-responsive table table-bordered table-striped">
                          <thead>
                            <tr>
                              <th>ID</th>
                              <th>Title</th>
                              <th>Content</th>
                              <th>Image</th>
                              <th>Type</th>
                              <th>Tag</th>
                              <th>Topic</th>
                              <th>Posted By</th>
                              <th>Action</th>
                            </tr>
                          </thead>

                        </table>
                      </div>
                    </div>
                    <!-- /.card-body -->
                  </div>
                  <!-- /.card -->
                </div>
                <!-- /.col -->
              </div>
              <!-- /.row -->
            </div>
            <!-- /.container-fluid -->
          </section>

          <div class="modal fade" id="modal-delete" style="display: none;" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h4 class="modal-title">Delete Article</h4>
                  <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                  </button>
                </div>
                <div class="modal-body">
                  <p>Are you sure you want to delete ?</p>
                </div>
                <div class="modal-footer justify-content-between">
                  <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                  <button type="submit" id="btnDelete" class="btn btn-danger">Delete</button>
                </div>
              </div>
              <!-- /.modal-content -->
            </div>
            <!-- /.modal-dialog -->
          </div>

          <div class="modal fade" id="modal-create" style="display: none;" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content bg-default" style="width: 600px;">
                <div class="modal-header">
                  <h4 class="modal-title">Create Article</h4>
                  <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                  </button>
                </div>
                <div class="modal-body">
                  <form id="add-article-form">
                    <div class="card-body">
                      <div class="form-group">
                        <label for="exampleInputPassword1">Title</label>
                        <input type="text" class="form-control" id="createtitle" placeholder="Enter Title" name="title">
                      </div>
                      <div class="form-group">
                        <label for="exampleInputPassword1">Type</label>
                        <select class="form-control" id="createtype" name="tag">
                          <option value="">Select Type</option>
                          <option value="baby">Baby</option>
                          <option value="pregnancy">Pregnancy</option>
                          <option value="parenthood">Parenthood</option>
                          <option value="family">Family</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="">Tag</label>
                        <select class="form-control" id="createtag" name="tag">
                          <option value="">Select Tag</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="exampleInputPassword1">Topic</label>
                        <select class="form-control" id="createtopic" name="article_topic_id">
                          <option value="">Select Topic</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="exampleInputFile">Image</label>
                        <div class="input-group">
                          <div class="custom-file">
                            <input type="file" class="custom-file-input" name="file" id="image" accept="image/*">
                            <label class="custom-file-label" for="exampleInputFile" id="create_file_name">Choose
                              file</label>
                          </div>
                        </div>
                        <img height="200px" width="200px" id="image_preview" style="display: none;" />
                        <small id="create_file_error" class="text-danger d-none">Invalid file type. Only images are
                          allowed.</small>
                      </div>
                      <textarea id="summernote" name="content">
                </textarea>
                    </div>
                    <!-- /.card-body -->
                    <div class="modal-footer justify-content-between">
                      <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                      <button type="submit" id="btnAdd" class="btn btn-secondary">Save changes</button>
                    </div>
                  </form>
                </div>
              </div>
              <!-- /.modal-content -->
            </div>
            <!-- /.modal-dialog -->
          </div>

          <div class="modal fade" id="modal-update" style="display: none;" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content bg-default" style="width: 600px;">
                <div class="modal-header">
                  <h4 class="modal-title">Article Details</h4>
                  <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                  </button>
                </div>
                <div class="modal-body">
                  <form id="article-form">
                    <input type="hidden" id="txtId">
                    <div class="card-body">
                      <div class="form-group">
                        <label for="title">Title</label>
                        <input type="text" class="form-control" id="title" placeholder="Enter Title" name="title">
                      </div>
                      <div class="form-group">
                        <label for="article_tag">Type</label>
                        <select class="form-control" id="article_tag" name="tag">
                          <option value="">Select Type</option>
                          <option value="baby">Baby</option>
                          <option value="pregnancy">Pregnancy</option>
                          <option value="parenthood">Parenthood</option>
                          <option value="family">Family</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="article_tag_select">Tag</label>
                        <select class="form-control" id="article_tag_select" name="tag_id">
                          <option value="">Select Tag</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="article_topic">Topic</label>
                        <select class="form-control" id="article_topic" name="article_topic_id">
                          <option value="">Select Topic</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="updimage">Image</label>
                        <div class="input-group">
                          <div class="custom-file">
                            <input type="file" class="custom-file-input" name="file" id="updimage" accept="image/*">
                            <label class="custom-file-label" for="updimage" id="file_name">Choose file</label>
                          </div>
                        </div>
                        <small id="file_error" class="text-danger d-none">Invalid file type. Only images are
                          allowed.</small>
                        <img height="200px" width="200px" id="updimage_preview" style="display: none;" />
                      </div>
                      <textarea id="upd_summernote" name="content"></textarea>
                    </div>
                    <!-- /.card-body -->
                    <div class="modal-footer justify-content-between">
                      <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                      <button type="submit" id="btnSubmit" class="btn btn-secondary">Save changes</button>
                    </div>
                  </form>
                </div>
              </div>
              <!-- /.modal-content -->
            </div>
            <!-- /.modal-dialog -->
          </div>

          <div class="modal fade" id="modal-overlay" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-sm" role="document" style="margin: 20% 45% auto;position: fixed;">
              <div class="modal-content">
                <div class="overlay">
                  <i class="fas fa-2x fa-sync fa-spin"></i>
                </div>
                <div class="modal-body">
                  <p>
                    <center>Adding an Article...</center>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->
        <%- include('partial/footer') %>

          <!-- Control Sidebar -->
          <aside class="control-sidebar control-sidebar-dark">
            <!-- Control sidebar content goes here -->
          </aside>
          <!-- /.control-sidebar -->
  </div>
  <!-- ./wrapper -->
  <script>
    $(function () {
      $('#summernote').summernote()
      $('#upd_summernote').summernote()

      bsCustomFileInput.init();

      $('.select2').select2();

      $('.select2-selection--single').css({
        'height': '38px',
        'border': '1px solid #ced4da'
      })
      $('.select2-selection__arrow').css({
        'height': '38px'
      })

      $(document).on('click', '[data-toggle="lightbox"]', function (event) {
        event.preventDefault();
        $(this).ekkoLightbox({
          alwaysShowClose: true
        });
      });
    })
  </script>
</body>

</html>